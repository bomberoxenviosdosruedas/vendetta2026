# .aiexclude - Filtro de contexto para herramientas y agentes IA
# Reduce drásticamente el consumo de tokens y omite archivos binarios, volcados pesados y artefactos de compilación.
#
# REGLA MAESTRA: Ver .gitignore para reglas base completas.
# Este archivo SOLO añade exclusiones específicas para IA que no aplican a Git.

# ----------------------------------------------------
# 1. Referencia a .gitignore (reglas base sincronizadas)
# ----------------------------------------------------
# Las siguientes reglas YA están en .gitignore y aplican aquí por referencia:
# - node_modules/, .pnp/, .yarn/
# - .next/, out/, build/, dist/, *.tsbuildinfo, next-env.d.ts
# - .env, .env*.local, .env.development, .env.production, .env.test
# - logs, *.log, npm-debug.log*, yarn-debug.log*, etc.
# - coverage/, .nyc_output/
# - .vercel/, .idx/, .genkit/*
# - .DS_Store, Thumbs.db, *.pem, *.key, *.cert, .idea/, *.sublime-*
# - *.sqlite, *.sqlite3, *.db, /src/generated/prisma, /vendetta/
# - public/img/, public/nuevas/, public/icons/, public/*.{gif,jpg,jpeg,png,webp,svg,ico}
# - *.mp4, *.mp3, *.wav, *.pdf
# - prisma/datosactuales/, prisma/export/, prisma/importar/, prisma/*.json
# - *.sql, *.sqlite, *.sqlite3, *.dump, *.csv, *.tsv, *.xlsx

# ----------------------------------------------------
# 2. Exclusiones ESPECÍFICAS para IA (no en .gitignore)
# ----------------------------------------------------

# Directorios de tooling IA internos
.agents/
.claude/
.hermes/
.stitch/

# Archivos de configuración IA locales
.aiexclude
.geminiignore
.antigravityignore
.cursorignore
.copilotignore

# Lockfiles masivos (commiteados en Git pero inútiles para contexto IA)
pnpm-lock.yaml
package-lock.json

# Documentación legacy archivada (movida a docs/knowledge_base/)
docs/knowledge_base/ARCHIVE-*
docs/knowledge_base/errores_imagenes/
docs/knowledge_base/MOCKUPS/*.png

# Archivos de build TypeScript
*.tsbuildinfo

# Cache de Turbo/Next
.turbo/
.cache/

# Datos de Prisma Studio / exports locales
prisma/studio/
prisma/migrations/.migration_lock.toml