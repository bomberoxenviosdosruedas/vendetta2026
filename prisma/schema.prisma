
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ==================================
//          MODELOS DE USUARIO
// ==================================

model User {
  id           String @id @default(cuid())
  name         String
  username     String @unique
  password     String
  title        String
  avatarUrl    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  propiedades  Propiedad[]
  entrenamientos EntrenamientoUsuario[]
  puntuacion   PuntuacionUsuario?
  misiones     ColaMisiones[]

  @@index([username])
}

model PuntuacionUsuario {
  id                    String @id @default(cuid())
  user                  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String @unique
  puntosHabitaciones    Float  @default(0)
  puntosTropas          Float  @default(0)
  puntosEntrenamientos  Float  @default(0)
  puntosTotales         Float  @default(0)

  @@index([puntosTotales])
}

model Propiedad {
  id                String    @id @default(cuid())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  nombre            String
  ciudad            Int
  barrio            Int
  edificio          Int
  armas             Float     @default(0)
  municion          Float     @default(0)
  alcohol           Float     @default(0)
  dolares           Float     @default(0)
  ultimaActualizacion DateTime  @default(now())

  habitaciones      HabitacionUsuario[]
  tropas            TropaUsuario[]
  colaConstruccion  ColaConstruccion[]
  colaReclutamiento ColaReclutamiento?
  misionesSalientes ColaMisiones[] @relation("MisionesSalientes")
  misionesEntrantes ColaMisiones[] @relation("MisionesEntrantes")


  @@unique([ciudad, barrio, edificio])
  @@index([userId])
}


// ==================================
//      MODELOS DE CONFIGURACIÓN
// ==================================

model ConfiguracionHabitacion {
  id                 String  @id
  nombre             String
  descripcion        String
  urlImagen          String
  costoArmas         Int
  costoMunicion      Int
  costoDolares       Int
  duracion           Int
  produccionBase     Float
  produccionRecurso  String?
  puntos             Float

  habitacionesUsuario   HabitacionUsuario[]
  escalado              ConfiguracionEscaladoHabitacion?
  colaConstruccion      ColaConstruccion[]
}

model ConfiguracionEscaladoHabitacion {
  id                       String                  @id @default(cuid())
  configuracionHabitacion  ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id], onDelete: Cascade)
  configuracionHabitacionId String                  @unique
  factorCostoPorNivel      Float
  produccionRecurso        String?
  formulaAumentoProduccion String?
  formulaTiempo            String?
}

model ConfiguracionEntrenamiento {
  id            String   @id
  nombre        String
  urlImagen     String
  costoArmas    Int
  costoMunicion Int
  costoDolares  Int
  duracion      Int
  puntos        Float

  entrenamientosUsuario EntrenamientoUsuario[]
}

enum TipoTropa {
  ATAQUE
  DEFENSA
  ESPIONAJE
  TRANSPORTE
  OCUPAR
}

model ConfiguracionTropa {
  id           String    @id
  nombre       String
  urlImagen    String
  descripcion  String
  costoArmas   Int
  costoMunicion Int
  costoDolares Int
  duracion     Int
  puntos       Float
  ataque       Int
  defensa      Int
  capacidad    Int
  velocidad    Int
  salario      Int
  tipo         TipoTropa
  requisitos   String[]
  bonusAtaque  String[]
  bonusDefensa String[]

  tropasUsuario    TropaUsuario[]
  colaReclutamiento ColaReclutamiento[]
}

// ==================================
//          MODELOS DE UNIÓN
// ==================================

model HabitacionUsuario {
  id                        String                  @id @default(cuid())
  propiedad                 Propiedad               @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId               String
  configuracion             ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id])
  configuracionHabitacionId String
  nivel                     Int                     @default(1)

  @@unique([propiedadId, configuracionHabitacionId])
  @@index([propiedadId])
}

model EntrenamientoUsuario {
  id                           String                     @id @default(cuid())
  user                         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                       String
  configuracion                ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id])
  configuracionEntrenamientoId String
  nivel                        Int                        @default(0)

  @@unique([userId, configuracionEntrenamientoId])
}

model TropaUsuario {
  id                   String             @id @default(cuid())
  propiedad            Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId          String
  configuracion        ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id])
  configuracionTropaId String
  cantidad             Int                @default(0)

  @@unique([propiedadId, configuracionTropaId])
  @@index([propiedadId])
}


// ==================================
//          MODELOS DE COLAS
// ==================================

model ColaConstruccion {
  id                String                  @id @default(cuid())
  propiedad         Propiedad               @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId       String
  habitacion        ConfiguracionHabitacion @relation(fields: [habitacionId], references: [id])
  habitacionId      String
  nivelDestino      Int
  duracion          Int
  fechaInicio       DateTime?
  fechaFinalizacion DateTime?
  createdAt         DateTime                @default(now())

  @@index([propiedadId])
}

model ColaReclutamiento {
  id                String             @id @default(cuid())
  propiedad         Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId       String             @unique
  tropaConfig       ConfiguracionTropa @relation(fields: [tropaId], references: [id])
  tropaId           String
  cantidad          Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime
}

enum TipoMision {
  ATAQUE
  DEFENDER
  TRANSPORTE
  ESPIONAJE
  OCUPAR
  REGRESO
}

model ColaMisiones {
  id                String      @id @default(cuid())
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  tipoMision        TipoMision
  tropas            String // JSON string de las tropas
  
  // Origen
  propiedadOrigen   Propiedad?    @relation("MisionesSalientes", fields: [propiedadOrigenId], references: [id], onDelete: SetNull)
  propiedadOrigenId String?
  origenCiudad      Int
  origenBarrio      Int
  origenEdificio    Int

  // Destino
  propiedadDestino  Propiedad?  @relation("MisionesEntrantes", fields: [propiedadDestinoId], references: [id], onDelete: SetNull)
  propiedadDestinoId String?
  destinoCiudad     Int
  destinoBarrio     Int
  destinoEdificio   Int

  // Tiempos
  fechaInicio       DateTime    @default(now())
  fechaLlegada      DateTime
  fechaRegreso      DateTime?
  duracionViaje     Int
  velocidadFlota    Int
  
  @@index([userId])
  @@index([propiedadOrigenId])
  @@index([propiedadDestinoId])
}
