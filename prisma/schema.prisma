// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===============================================
//           MODELOS DE IDENTIDAD Y PROGRESO
// ===============================================

model User {
  id            String    @id @default(cuid())
  name          String
  username      String    @unique
  password      String // En una aplicación real, esto debería ser un hash
  title         String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  
  progreso      ProgresoUsuario?
  habitaciones  HabitacionUsuario[]
  entrenamientos EntrenamientoUsuario[]
  tropas        TropaUsuario[]
}

model ProgresoUsuario {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  
  dolares             Float    @default(500)
  armas               Float    @default(500)
  municion            Float    @default(2000)
  alcohol             Float    @default(100)
  
  capacidadAlmacenDolares  Int @default(10000)
  capacidadAlmacenArmas    Int @default(10000)
  capacidadAlmacenMunicion Int @default(10000)
  capacidadAlmacenAlcohol  Int @default(10000)

  ultimaActualizacion DateTime @default(now())
}

model HabitacionUsuario {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id])
  configuracionHabitacionId String
  configuracionHabitacion ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id])
  
  nivel                 Int      @default(0)
  
  @@unique([userId, configuracionHabitacionId])
}

model EntrenamientoUsuario {
  id                       String   @id @default(cuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id])
  configuracionEntrenamientoId String
  configuracionEntrenamiento ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id])
  
  nivel                    Int      @default(0)

  @@unique([userId, configuracionEntrenamientoId])
}

model TropaUsuario {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  configuracionTropaId String
  configuracionTropa ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id])

  cantidad          Int      @default(0)

  @@unique([userId, configuracionTropaId])
}

// ===============================================
//           MODELOS DE CONFIGURACIÓN ESTÁTICA
// ===============================================

model ConfiguracionHabitacion {
  id            String   @id
  nombre        String
  descripcion   String
  urlImagen     String?
  costoArmas    Int
  costoMunicion Int
  costoDolares  Int
  duracion      Int // en segundos
  produccion    Float
  puntos        Float
  
  usuarios      HabitacionUsuario[]
}

model ConfiguracionEntrenamiento {
  id            String   @id
  nombre        String
  urlImagen     String?
  costoArmas    Int
  costoMunicion Int
  costoDolares  Int
  duracion      Int // en segundos
  puntos        Float

  usuarios      EntrenamientoUsuario[]
}

model ConfiguracionTropa {
  id            String   @id
  nombre        String
  descripcion   String
  urlImagen     String?
  costoArmas    Int
  costoMunicion Int
  costoDolares  Int
  duracion      Int
  puntos        Float
  ataque        Int
  defensa       Int
  capacidad     Int
  velocidad     Int
  salario       Int
  requisitos    String[]
  bonusAtaque   String[]
  bonusDefensa  String[]

  usuarios      TropaUsuario[]
}
