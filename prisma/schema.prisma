// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SuperUser {
  id       String @id @default(cuid())
  username String @unique
  password String
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String
  userAgent String
  createdAt DateTime @default(now())

  @@index([userId])
}

model User {
  id             String        @id @default(cuid())
  name           String
  username       String        @unique
  password       String
  title          String?
  avatarUrl      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  propiedades    Propiedad[]
  entrenamientos EntrenamientoUsuario[]
  puntuacion     PuntuacionUsuario?
  misiones       ColaMisiones[]

  familyMember   FamilyMember?
  sentMessages   Message[]     @relation("Sender")
  receivedMessages Message[]   @relation("Recipient")
  invitations    FamilyInvitation[]

  loginHistory   LoginHistory[]

  @@index([username])
}

model Propiedad {
  id                  String             @id @default(cuid())
  userId              String
  nombre              String
  ciudad              Int
  barrio              Int
  edificio            Int
  armas               Float              @default(0)
  municion            Float              @default(0)
  alcohol             Float              @default(0)
  dolares             Float              @default(0)
  ultimaActualizacion DateTime           @default(now())
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitaciones        HabitacionUsuario[]
  colaConstruccion    ColaConstruccion[]
  colaReclutamiento   ColaReclutamiento?
  misionesOrigen      ColaMisiones[]     @relation("MisionesOrigen")
  TropaUsuario        TropaUsuario[]
  TropaSeguridadUsuario TropaSeguridadUsuario[]

  @@unique([ciudad, barrio, edificio])
  @@index([userId])
}

model HabitacionUsuario {
  id                        String                @id @default(cuid())
  propiedadId               String
  configuracionHabitacionId String
  nivel                     Int                   @default(1)
  propiedad                 Propiedad             @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion             ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id], onDelete: Cascade)

  @@unique([propiedadId, configuracionHabitacionId])
}

model EntrenamientoUsuario {
  id                             String                     @id @default(cuid())
  userId                         String
  configuracionEntrenamientoId   String
  nivel                          Int                        @default(0)
  user                           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuracion                  ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id], onDelete: Cascade)

  @@unique([userId, configuracionEntrenamientoId])
}

model TropaUsuario {
  id                     String           @id @default(cuid())
  propiedadId            String
  configuracionTropaId   String
  cantidad               Int
  propiedad              Propiedad        @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion          ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id], onDelete: Cascade)

  @@unique([propiedadId, configuracionTropaId])
}

model TropaSeguridadUsuario {
  id                     String           @id @default(cuid())
  propiedadId            String
  configuracionTropaId   String
  cantidad               Int
  propiedad              Propiedad        @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion          ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id], onDelete: Cascade)

  @@unique([propiedadId, configuracionTropaId])
}

model PuntuacionUsuario {
  id                   String   @id @default(cuid())
  userId               String   @unique
  puntosHabitaciones   Float
  puntosTropas         Float
  puntosEntrenamientos Float
  puntosTotales        Float
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt            DateTime @updatedAt
}

model ColaConstruccion {
  id                String      @id @default(cuid())
  propiedadId       String
  habitacionId      String
  nivelDestino      Int
  duracion          Int
  fechaInicio       DateTime?
  fechaFinalizacion DateTime?
  createdAt         DateTime    @default(now())
  propiedad         Propiedad   @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  @@index([propiedadId])
}

model ColaReclutamiento {
  id                String      @id @default(cuid())
  propiedadId       String      @unique
  tropaId           String
  cantidad          Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime
  propiedad         Propiedad   @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  tropaConfig       ConfiguracionTropa @relation(fields: [tropaId], references: [id], onDelete: Cascade)
}

model ColaEntrenamiento {
    id                String      @id @default(cuid())
    userId            String
    propiedadId       String
    entrenamientoId   String      @unique
    nivelDestino      Int
    fechaInicio       DateTime
    fechaFinalizacion DateTime
    user              User        @relation(fields: [userId], references: [id])
    propiedad         Propiedad   @relation(fields: [propiedadId], references: [id])
    entrenamiento     ConfiguracionEntrenamiento @relation(fields: [entrenamientoId], references: [id])

    @@index([userId])
    @@index([propiedadId])
}

model ColaMisiones {
  id                String    @id @default(cuid())
  userId            String
  propiedadOrigenId String
  tipoMision        String
  tropas            String // JSON string de tropas y cantidades
  origenCiudad      Int
  origenBarrio      Int
  origenEdificio    Int
  destinoCiudad     Int
  destinoBarrio     Int
  destinoEdificio   Int
  fechaInicio       DateTime
  fechaLlegada      DateTime
  fechaRegreso      DateTime?
  velocidadFlota    Float
  duracionViaje     Int

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  propiedad Propiedad @relation("MisionesOrigen", fields: [propiedadOrigenId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Modelos de configuración del juego

model ConfiguracionHabitacion {
  id                   String                @id
  nombre               String
  descripcion          String                @db.Text
  urlImagen            String
  costoArmas           Int
  costoMunicion        Int
  costoDolares         Int
  duracion             Int
  produccionBase       Float
  produccionRecurso    String?
  puntos               Float
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  HabitacionUsuario    HabitacionUsuario[]
  requirements         RoomRequirement[]     @relation("RequiredFor")
  requiredFor          RoomRequirement[]     @relation("Requirement")
}

model RoomRequirement {
    roomId           String
    requiredRoomId   String
    requiredLevel    Int
    room             ConfiguracionHabitacion @relation("RequiredFor", fields: [roomId], references: [id], onDelete: Cascade)
    requiredRoom     ConfiguracionHabitacion @relation("Requirement", fields: [requiredRoomId], references: [id], onDelete: Cascade)

    @@id([roomId, requiredRoomId])
}

model ConfiguracionEscaladoHabitacion {
  id                           String @id @default(cuid())
  habitacionId                 String @unique
  factor_costo_por_nivel       Float
  formula_aumento_produccion   String
  formula_tiempo               String
  configuracionHabitacion      ConfiguracionHabitacion @relation(fields: [habitacionId], references: [id])
}

model ConfiguracionEntrenamiento {
  id                   String                @id
  nombre               String
  urlImagen            String
  costoArmas           Int
  costoMunicion        Int
  costoDolares         Int
  duracion             Int
  puntos               Float
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  EntrenamientoUsuario EntrenamientoUsuario[]
  colaEntrenamientos   ColaEntrenamiento[]
  requirements         TrainingRequirement[] @relation("RequiredFor")
  requiredFor          TrainingRequirement[] @relation("Requirement")
}

model TrainingRequirement {
    trainingId         String
    requiredTrainingId String
    requiredLevel      Int
    training           ConfiguracionEntrenamiento @relation("RequiredFor", fields: [trainingId], references: [id], onDelete: Cascade)
    requiredTraining   ConfiguracionEntrenamiento @relation("Requirement", fields: [requiredTrainingId], references: [id], onDelete: Cascade)

    @@id([trainingId, requiredTrainingId])
}


model ConfiguracionTropa {
  id                 String              @id
  nombre             String
  urlImagen          String
  descripcion        String              @db.Text
  costoArmas         Int
  costoMunicion      Int
  costoDolares       Int
  duracion           Int
  puntos             Float
  ataque             Int
  defensa            Int
  capacidad          Int
  velocidad          Int
  salario            Int
  tipo               TipoTropa
  requisitos         String[]
  bonusAtaque        String[]
  bonusDefensa       String[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  TropaUsuario       TropaUsuario[]
  ColaReclutamiento  ColaReclutamiento[]
  TropaSeguridadUsuario TropaSeguridadUsuario[]
  bonusContrincante  TropaBonusContrincante[] @relation("Atacante")
  bonificadoPor      TropaBonusContrincante[] @relation("Defensora")
}

model TropaBonusContrincante {
    tropaAtacanteId   String
    tropaDefensoraId  String
    factorPrioridad   Float
    tropaAtacante     ConfiguracionTropa @relation("Atacante", fields: [tropaAtacanteId], references: [id], onDelete: Cascade)
    tropaDefensora    ConfiguracionTropa @relation("Defensora", fields: [tropaDefensoraId], references: [id], onDelete: Cascade)
    
    @@id([tropaAtacanteId, tropaDefensoraId])
}

enum TipoTropa {
  ATAQUE
  DEFENSA
  TRANSPORTE
  ESPIONAJE
  OCUPAR
}

model PoderAtaque {
    id          String @id @default(cuid())
    propiedades Int
    honor       Int
    modificador Int

    @@unique([propiedades, honor])
}

// Modelos de Familia
model Family {
  id          String   @id @default(cuid())
  name        String   @unique
  tag         String   @unique
  description String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     FamilyMember[]
  invitations FamilyInvitation[]
}

model FamilyMember {
  id        String    @id @default(cuid())
  userId    String    @unique
  familyId  String
  role      FamilyRole @default(MEMBER)
  joinedAt  DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

enum FamilyRole {
  LEADER
  CO_LEADER
  MEMBER
}

model FamilyInvitation {
  id        String   @id @default(cuid())
  familyId  String
  userId    String
  status    String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  expiresAt DateTime @default(dbgenerated("now() + interval '7 day'"))
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
}

// Modelos de Mensajería
model Message {
  id          String   @id @default(cuid())
  senderId    String?  // Nullable para mensajes del sistema
  recipientId String
  subject     String
  content     String   @db.Text
  isRead      Boolean  @default(false)
  category    MessageCategory
  createdAt   DateTime @default(now())
  
  sender      User?    @relation("Sender", fields: [senderId], references: [id], onDelete: SetNull)
  recipient   User     @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead])
}

enum MessageCategory {
  JUGADOR
  FAMILIA
  SISTEMA
  BATALLA
  CONSTRUCCION
}
