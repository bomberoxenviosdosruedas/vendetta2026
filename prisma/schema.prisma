// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------
// --- MODELOS BASE DE CONFIGURACIÓN ---
// ---------------------

model ConfiguracionHabitacion {
  id                 String   @id @default(cuid())
  nombre             String
  descripcion        String?
  urlImagen          String?
  costoArmas         Int
  costoMunicion      Int
  costoDolares       Int
  duracion           Int
  produccionBase     Int
  produccionRecurso  String?
  puntos             Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  // Relaciones
  habitacionesUsuario     HabitacionUsuario[]
  colaConstruccion        ColaConstruccion[]
  requirements            RoomRequirement[]   @relation("requiredFor")
  requiredBy              RoomRequirement[]   @relation("requirements")
}

model RoomRequirement {
  roomId           String
  requiredRoomId   String
  requiredLevel    Int
  
  room             ConfiguracionHabitacion @relation("requiredFor", fields: [roomId], references: [id], onDelete: Cascade)
  requiredRoom     ConfiguracionHabitacion @relation("requirements", fields: [requiredRoomId], references: [id], onDelete: Cascade)

  @@id([roomId, requiredRoomId])
}


model ConfiguracionEntrenamiento {
  id              String   @id @default(cuid())
  nombre          String
  urlImagen       String?
  costoArmas      Int
  costoMunicion   Int
  costoDolares    Int
  duracion        Int
  puntos          Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  entrenamientosUsuario EntrenamientoUsuario[]
  requirements          TrainingRequirement[]  @relation("requiredFor")
  requiredBy            TrainingRequirement[]  @relation("requirements")
}

model TrainingRequirement {
  trainingId         String
  requiredTrainingId String
  requiredLevel      Int

  training         ConfiguracionEntrenamiento @relation("requiredFor", fields: [trainingId], references: [id], onDelete: Cascade)
  requiredTraining ConfiguracionEntrenamiento @relation("requirements", fields: [requiredTrainingId], references: [id], onDelete: Cascade)

  @@id([trainingId, requiredTrainingId])
}

model ConfiguracionTropa {
  id                  String   @id @default(cuid())
  nombre              String
  urlImagen           String?
  descripcion         String?
  costoArmas          Int
  costoMunicion       Int
  costoDolares        Int
  duracion            Int
  puntos              Float
  ataque              Int
  defensa             Int
  capacidad           Int
  velocidad           Int
  salario             Int
  tipo                TipoTropa
  requisitos          String[] // Simplificado por ahora, podría ser una tabla relacional
  bonusAtaque         String[] // IDs de ConfiguracionEntrenamiento
  bonusDefensa        String[] // IDs de ConfiguracionEntrenamiento
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relaciones
  TropaUsuario        TropaUsuario[]
  colaReclutamiento   ColaReclutamiento[]
  bonusContrincante   TropaBonusContrincante[] @relation("atacante")
  esBonusContrincante TropaBonusContrincante[] @relation("defensor")
}

model TropaBonusContrincante {
  tropaAtacanteId   String
  tropaDefensoraId  String
  factorPrioridad   Float // Ej: 1.5 significa 50% más de daño prioritario

  tropaAtacante    ConfiguracionTropa @relation("atacante", fields: [tropaAtacanteId], references: [id], onDelete: Cascade)
  tropaDefensora   ConfiguracionTropa @relation("defensor", fields: [tropaDefensoraId], references: [id], onDelete: Cascade)
  
  @@id([tropaAtacanteId, tropaDefensoraId])
}

enum TipoTropa {
  ATAQUE
  DEFENSA
  ESPIONAJE
  TRANSPORTE
  OCUPAR
}


// ---------------------
// --- MODELOS DE USUARIO Y PROGRESO ---
// ---------------------

model User {
  id                   String            @id @default(cuid())
  name                 String
  username             String            @unique
  password             String
  title                String?
  avatarUrl            String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  
  // Relaciones
  propiedades          Propiedad[]
  entrenamientos       EntrenamientoUsuario[]
  puntuacion           PuntuacionUsuario?
  misiones             ColaMisiones[]
  familyMember         FamilyMember?
  invitations          FamilyInvitation[]
}

model Propiedad {
  id                String      @id @default(cuid())
  userId            String
  nombre            String
  ciudad            Int
  barrio            Int
  edificio          Int
  armas             Float       @default(0)
  municion          Float       @default(0)
  alcohol           Float       @default(0)
  dolares           Float       @default(0)
  ultimaActualizacion DateTime  @default(now())

  // Relaciones
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitaciones      HabitacionUsuario[]
  TropaUsuario      TropaUsuario[]
  colaConstruccion  ColaConstruccion[]
  colaReclutamiento ColaReclutamiento?
  misionesOrigen    ColaMisiones[]      @relation("Origen")
  misionesDestino   ColaMisiones[]      @relation("Destino")

  @@unique([ciudad, barrio, edificio])
}

model HabitacionUsuario {
  id                          String      @id @default(cuid())
  propiedadId                 String
  configuracionHabitacionId   String
  nivel                       Int         @default(0)

  // Relaciones
  propiedad        Propiedad             @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion    ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id], onDelete: Cascade)

  @@unique([propiedadId, configuracionHabitacionId])
}

model TropaUsuario {
  id                      String      @id @default(cuid())
  propiedadId             String
  configuracionTropaId    String
  cantidad                Int

  // Relaciones
  propiedad               Propiedad           @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion           ConfiguracionTropa  @relation(fields: [configuracionTropaId], references: [id], onDelete: Cascade)

  @@unique([propiedadId, configuracionTropaId])
}

model EntrenamientoUsuario {
  id                                String      @id @default(cuid())
  userId                            String
  configuracionEntrenamientoId      String
  nivel                             Int

  // Relaciones
  user                  User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuracion         ConfiguracionEntrenamiento    @relation(fields: [configuracionEntrenamientoId], references: [id], onDelete: Cascade)

  @@unique([userId, configuracionEntrenamientoId])
}

model PuntuacionUsuario {
  id                    String      @id @default(cuid())
  userId                String      @unique
  puntosHabitaciones    Float
  puntosTropas          Float
  puntosEntrenamientos  Float
  puntosTotales         Float
  
  // Relaciones
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}


// ---------------------
// --- MODELOS DE COLAS DE EVENTOS ---
// ---------------------

model ColaConstruccion {
  id                String      @id @default(cuid())
  propiedadId       String
  habitacionId      String
  nivelDestino      Int
  duracion          Int
  fechaInicio       DateTime?
  fechaFinalizacion DateTime?
  createdAt         DateTime    @default(now())

  // Relaciones
  propiedad         Propiedad             @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  habitacionConfig  ConfiguracionHabitacion @relation(fields: [habitacionId], references: [id], onDelete: Cascade)
}

model ColaReclutamiento {
  id                String      @id @default(cuid())
  propiedadId       String      @unique
  tropaId           String
  cantidad          Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime

  // Relaciones
  propiedad        Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  tropaConfig      ConfiguracionTropa @relation(fields: [tropaId], references: [id], onDelete: Cascade)
}

model ColaMisiones {
    id                String      @id @default(cuid())
    userId            String
    propiedadOrigenId String?
    tipoMision        String
    tropas            String // JSON string de las tropas
    
    origenCiudad      Int
    origenBarrio      Int
    origenEdificio    Int

    destinoCiudad     Int
    destinoBarrio     Int
    destinoEdificio   Int

    fechaInicio       DateTime
    fechaLlegada      DateTime
    fechaRegreso      DateTime?

    velocidadFlota    Int
    duracionViaje     Int

    // Relaciones
    user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    propiedadOrigen   Propiedad?  @relation("Origen", fields: [propiedadOrigenId], references: [id], onDelete: SetNull)
    propiedadDestino  Propiedad?  @relation("Destino", fields: [destinoCiudad, destinoBarrio, destinoEdificio], references: [ciudad, barrio, edificio], onDelete: SetNull)
}

// ---------------------
// --- MODELOS DE FAMILIAS ---
// ---------------------

model Family {
  id            String   @id @default(cuid())
  name          String   @unique
  tag           String   @unique
  description   String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       FamilyMember[]
  invitations   FamilyInvitation[]
}

model FamilyMember {
  userId      String     @id
  familyId    String
  role        FamilyRole @default(MEMBER)
  joinedAt    DateTime   @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  family      Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
}

model FamilyInvitation {
  id          String   @id @default(cuid())
  familyId    String
  userId      String
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
}

enum FamilyRole {
  LEADER
  CO_LEADER
  MEMBER
}
