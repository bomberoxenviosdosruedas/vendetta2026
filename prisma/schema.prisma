// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id                  String             @id @default(cuid())
  name                String
  username            String             @unique
  password            String
  title               String?            @default("Nuevo Jefe")
  avatarUrl           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  propiedades         Propiedad[]
  entrenamientos      EntrenamientoUsuario[]
  puntuacion          PuntuacionUsuario?
  misiones            ColaMisiones[]
}

model Propiedad {
  id                    String        @id @default(cuid())
  userId                String
  nombre                String
  ciudad                Int
  barrio                Int
  edificio              Int
  armas                 Float         @default(10000)
  municion              Float         @default(10000)
  alcohol               Float         @default(10000)
  dolares               Float         @default(10000)
  ultimaActualizacion   DateTime      @default(now())

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitaciones          HabitacionUsuario[]
  tropas                TropaUsuario[]
  colaConstruccion      ColaConstruccion[]
  colaReclutamiento     ColaReclutamiento?
  misionesOrigen        ColaMisiones[] @relation("MisionesOrigen")
  
  @@unique([ciudad, barrio, edificio])
  @@index([userId])
}


model HabitacionUsuario {
  id                        String      @id @default(cuid())
  propiedadId               String
  configuracionHabitacionId String
  nivel                     Int

  propiedad                 Propiedad   @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion             ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id], onDelete: Cascade)

  @@unique([propiedadId, configuracionHabitacionId])
  @@index([propiedadId])
}

model EntrenamientoUsuario {
  id                           String                    @id @default(cuid())
  userId                       String
  configuracionEntrenamientoId String
  nivel                        Int

  user                         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuracion                ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id], onDelete: Cascade)

  @@unique([userId, configuracionEntrenamientoId])
  @@index([userId])
}

model TropaUsuario {
  id                   String            @id @default(cuid())
  propiedadId          String
  configuracionTropaId String
  cantidad             Int

  propiedad            Propiedad         @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion        ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id], onDelete: Cascade)

  @@unique([propiedadId, configuracionTropaId])
  @@index([propiedadId])
}

model PuntuacionUsuario {
  id                   String @id @default(cuid())
  userId               String @unique
  puntosHabitaciones  Float
  puntosTropas         Float
  puntosEntrenamientos Float
  puntosTotales        Float
  
  user                 User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}


// --- CONFIGURACIÓN DEL JUEGO ---

model ConfiguracionHabitacion {
  id                      String      @id @unique
  nombre                  String
  descripcion             String
  urlImagen               String
  costoArmas              Int
  costoMunicion           Int
  costoDolares            Int
  duracion                Int
  produccionBase          Int
  produccionRecurso       String?
  puntos                  Float

  habitaciones            HabitacionUsuario[]
  escalado                ConfiguracionEscaladoHabitacion?
  colaConstruccion        ColaConstruccion[]
}

model ConfiguracionEscaladoHabitacion {
  id                      String      @id @default(cuid())
  habitacionId            String      @unique
  factorCostoPorNivel     Float       @default(1.2)
  produccionRecurso       String?
  formulaAumentoProduccion String?
  
  habitacion              ConfiguracionHabitacion @relation(fields: [habitacionId], references: [id], onDelete: Cascade)
}

model ConfiguracionEntrenamiento {
  id                      String      @id @unique
  nombre                  String
  urlImagen               String
  costoArmas              Int
  costoMunicion           Int
  costoDolares            Int
  duracion                Int
  puntos                  Float

  entrenamientos          EntrenamientoUsuario[]
}

model ConfiguracionTropa {
  id                      String      @id @unique
  nombre                  String
  urlImagen               String
  descripcion             String
  costoArmas              Int
  costoMunicion           Int
  costoDolares            Int
  duracion                Int
  puntos                  Float
  ataque                  Int
  defensa                 Int
  capacidad               Int
  velocidad               Int
  salario                 Int
  tipo                    TipoTropa
  requisitos              String[]
  bonusAtaque             String[]
  bonusDefensa            String[]
  
  tropas                  TropaUsuario[]
  colaReclutamiento       ColaReclutamiento[]
}

// --- COLAS DE EVENTOS ---

model ColaConstruccion {
  id                   String      @id @default(cuid())
  propiedadId          String
  habitacionId         String
  nivelDestino         Int
  duracion             Int
  fechaInicio          DateTime?
  fechaFinalizacion    DateTime?
  createdAt            DateTime    @default(now())

  propiedad            Propiedad   @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  habitacionConfig     ConfiguracionHabitacion @relation(fields: [habitacionId], references: [id], onDelete: Cascade)
  
  @@index([propiedadId])
}

model ColaReclutamiento {
  id                String      @id @default(cuid())
  propiedadId       String      @unique
  tropaId           String
  cantidad          Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime

  propiedad         Propiedad   @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  tropaConfig       ConfiguracionTropa @relation(fields: [tropaId], references: [id], onDelete: Cascade)
}

model ColaMisiones {
  id                   String      @id @default(cuid())
  userId               String
  propiedadOrigenId    String
  tipoMision           String
  tropas               String // JSON string
  origenCiudad         Int
  origenBarrio         Int
  origenEdificio       Int
  destinoCiudad        Int
  destinoBarrio        Int
  destinoEdificio      Int
  fechaInicio          DateTime    @default(now())
  fechaLlegada         DateTime
  fechaRegreso         DateTime?
  velocidadFlota       Int
  duracionViaje        Int

  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  propiedadOrigen      Propiedad   @relation("MisionesOrigen", fields: [propiedadOrigenId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TipoTropa {
  ATAQUE
  DEFENSA
  ESPIONAJE
  OCUPAR
}
