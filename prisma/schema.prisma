// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String             @id @default(cuid())
  name               String
  username           String             @unique
  password           String
  title              String?
  avatarUrl          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  propiedades        Propiedad[]
  entrenamientos     EntrenamientoUsuario[]
  puntuacion         PuntuacionUsuario?
  misiones           ColaMisiones[]
  familyMember       FamilyMember?
  sentMessages       Message[]          @relation("SentMessages")
  receivedMessages   Message[]          @relation("ReceivedMessages")
  sentInvitations    FamilyInvitation[] @relation("SentInvitations")
  receivedInvitation FamilyInvitation?  @relation("ReceivedInvitation")
}

model Propiedad {
  id                  String             @id @default(cuid())
  userId              String
  nombre              String
  ciudad              Int
  barrio              Int
  edificio            Int
  armas               Float              @default(0)
  municion            Float              @default(0)
  alcohol             Float              @default(0)
  dolares             Float              @default(0)
  ultimaActualizacion DateTime           @default(now())
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitaciones        HabitacionUsuario[]
  colaConstruccion    ColaConstruccion[]
  colaReclutamiento   ColaReclutamiento?
  misiones            ColaMisiones[]

  @@unique([ciudad, barrio, edificio])
  @@index([userId])
}

model HabitacionUsuario {
  id                          String                  @id @default(cuid())
  propiedadId                 String
  configuracionHabitacionId   String
  nivel                       Int                     @default(0)
  propiedad                   Propiedad               @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion               ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id], onDelete: Cascade)

  @@unique([propiedadId, configuracionHabitacionId])
}

model ConfiguracionHabitacion {
  id                 String              @id
  nombre             String
  descripcion        String              @db.Text
  urlImagen          String?
  costoArmas         Int
  costoMunicion      Int
  costoDolares       Int
  duracion           Int
  produccionBase     Int
  produccionRecurso  String?
  puntos             Float
  habitaciones       HabitacionUsuario[]
  colaConstruccion   ColaConstruccion[]
  requirements       RoomRequirement[]   @relation("RoomRequirements")
  requiredFor        RoomRequirement[]   @relation("RequiredForRooms")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model RoomRequirement {
  roomId           String
  requiredRoomId   String
  requiredLevel    Int
  room             ConfiguracionHabitacion @relation("RoomRequirements", fields: [roomId], references: [id], onDelete: Cascade)
  requiredRoom     ConfiguracionHabitacion @relation("RequiredForRooms", fields: [requiredRoomId], references: [id], onDelete: Cascade)

  @@id([roomId, requiredRoomId])
}

model EntrenamientoUsuario {
  id                               String                     @id @default(cuid())
  userId                           String
  configuracionEntrenamientoId   String
  nivel                            Int                        @default(0)
  user                             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuracion                    ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id], onDelete: Cascade)

  @@unique([userId, configuracionEntrenamientoId])
}

model ConfiguracionEntrenamiento {
  id                 String                @id
  nombre             String
  urlImagen          String?
  costoArmas         Int
  costoMunicion      Int
  costoDolares       Int
  duracion           Int
  puntos             Float
  usuarios           EntrenamientoUsuario[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  requirements       TrainingRequirement[] @relation("TrainingRequirements")
  requiredFor        TrainingRequirement[] @relation("RequiredForTrainings")
}

model TrainingRequirement {
  trainingId         String
  requiredTrainingId String
  requiredLevel      Int
  training           ConfiguracionEntrenamiento @relation("TrainingRequirements", fields: [trainingId], references: [id], onDelete: Cascade)
  requiredTraining   ConfiguracionEntrenamiento @relation("RequiredForTrainings", fields: [requiredTrainingId], references: [id], onDelete: Cascade)

  @@id([trainingId, requiredTrainingId])
}


model TropaUsuario {
  id                     String             @id @default(cuid())
  propiedadId            String
  configuracionTropaId   String
  cantidad               Int                @default(0)
  propiedad              Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion          ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id], onDelete: Cascade)

  @@unique([propiedadId, configuracionTropaId])
}

enum TipoTropa {
  ATAQUE
  DEFENSA
  ESPIONAJE
  TRANSPORTE
  OCUPAR
}

model ConfiguracionTropa {
  id                   String             @id
  nombre               String
  urlImagen            String?
  descripcion          String             @db.Text
  costoArmas           Int
  costoMunicion        Int
  costoDolares         Int
  duracion             Int
  puntos               Float
  ataque               Int
  defensa              Int
  capacidad            Int
  velocidad            Int
  salario              Int
  tipo                 TipoTropa
  requisitos           String[]
  bonusAtaque          String[]
  bonusDefensa         String[]
  tropas               TropaUsuario[]
  colaReclutamiento    ColaReclutamiento[]
  bonusContrincante    TropaBonusContrincante[] @relation("Atacante")
  bonusContrincadoPor  TropaBonusContrincante[] @relation("Defensor")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model TropaBonusContrincante {
  tropaAtacanteId   String
  tropaDefensoraId  String
  factorPrioridad   Float
  tropaAtacante     ConfiguracionTropa @relation("Atacante", fields: [tropaAtacanteId], references: [id], onDelete: Cascade)
  tropaDefensora    ConfiguracionTropa @relation("Defensor", fields: [tropaDefensoraId], references: [id], onDelete: Cascade)

  @@id([tropaAtacanteId, tropaDefensoraId])
}

model PuntuacionUsuario {
  id                   String @id @default(cuid())
  userId               String @unique
  puntosHabitaciones   Float
  puntosTropas         Float
  puntosEntrenamientos Float
  puntosTotales        Float
  user                 User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ColaConstruccion {
  id                String                  @id @default(cuid())
  propiedadId       String
  habitacionId      String
  nivelDestino      Int
  duracion          Int
  fechaInicio       DateTime?
  fechaFinalizacion DateTime?
  propiedad         Propiedad               @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  habitacion        ConfiguracionHabitacion @relation(fields: [habitacionId], references: [id], onDelete: Cascade)
  createdAt         DateTime                @default(now())
}

model ColaReclutamiento {
  id                String             @id @default(cuid())
  propiedadId       String             @unique
  tropaId           String
  cantidad          Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime
  propiedad         Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  tropaConfig       ConfiguracionTropa @relation(fields: [tropaId], references: [id], onDelete: Cascade)
}

model ColaMisiones {
  id                String    @id @default(cuid())
  userId            String
  propiedadOrigenId String
  tipoMision        String
  tropas            String
  origenCiudad      Int
  origenBarrio      Int
  origenEdificio    Int
  destinoCiudad     Int
  destinoBarrio     Int
  destinoEdificio   Int
  fechaInicio       DateTime
  fechaLlegada      DateTime
  fechaRegreso      DateTime?
  duracionViaje     Int
  velocidadFlota    Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  propiedad         Propiedad @relation(fields: [propiedadOrigenId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Family {
  id          String             @id @default(cuid())
  name        String             @unique
  tag         String             @unique
  description String?
  avatarUrl   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  members     FamilyMember[]
  invitations FamilyInvitation[]
}

enum FamilyRole {
  LEADER
  CO_LEADER
  MEMBER
}

model FamilyMember {
  userId    String     @id @unique
  familyId  String
  role      FamilyRole @default(MEMBER)
  joinedAt  DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model FamilyInvitation {
  id        String           @id @default(cuid())
  familyId  String
  userId    String           @unique
  inviterId String
  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  expiresAt DateTime         @default(dbgenerated("NOW() + interval '7 days'"))
  family    Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User             @relation("ReceivedInvitation", fields: [userId], references: [id], onDelete: Cascade)
  inviter   User             @relation("SentInvitations", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
}

enum MessageCategory {
  JUGADOR
  BATALLA
  CONSTRUCCION
  SISTEMA
}

model Message {
  id          String          @id @default(cuid())
  senderId    String? // Nullable for system messages
  recipientId String
  subject     String
  content     String          @db.Text
  category    MessageCategory
  isRead      Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  sender    User? @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User  @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, category, createdAt])
}
