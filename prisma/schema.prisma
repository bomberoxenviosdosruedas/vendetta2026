generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String          @id @default(cuid())
  name             String
  username         String          @unique
  password         String
  title            String
  avatarUrl        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  progreso         ProgresoUsuario?
  habitaciones     HabitacionUsuario[]
  entrenamientos   EntrenamientoUsuario[]
  tropas           TropaUsuario[]
  colaConstruccion ColaConstruccion?
}

model ProgresoUsuario {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dolares             Float    @default(0)
  armas               Float    @default(0)
  municion            Float    @default(0)
  alcohol             Float    @default(0)
  ultimaActualizacion DateTime @default(now())
}

model HabitacionUsuario {
  id                          String                  @id @default(cuid())
  userId                      String
  user                        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuracionHabitacionId   String
  configuracion               ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id])
  nivel                       Int                     @default(0)

  @@unique([userId, configuracionHabitacionId])
}

model EntrenamientoUsuario {
  id                             String                     @id @default(cuid())
  userId                         String
  user                           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuracionEntrenamientoId   String
  configuracion                  ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id])
  nivel                          Int                        @default(0)

  @@unique([userId, configuracionEntrenamientoId])
}

model TropaUsuario {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuracionTropaId String
  configuracion        ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id])
  cantidad             Int                @default(0)

  @@unique([userId, configuracionTropaId])
}

model ColaConstruccion {
  id                String     @id @default(cuid())
  userId            String     @unique
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitacionId      String
  nivelDestino      Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime

  @@index([userId])
}

// --- Tablas de Configuración (Datos estáticos del juego) ---

model ConfiguracionHabitacion {
  id             String                          @id @unique
  nombre         String
  descripcion    String
  urlImagen      String?
  costoArmas     Int
  costoMunicion  Int
  costoDolares   Int
  duracion       Int // en segundos
  produccion     Float
  puntos         Float
  HabitacionUsuario    HabitacionUsuario[]
  escalado       ConfiguracionEscaladoHabitacion? @relation(fields: [id], references: [id])
}

model ConfiguracionEscaladoHabitacion {
  id                        String  @id @unique
  produccionRecurso         String?
  formulaAumentoProduccion  String?
  factorCostoPorNivel       Float
  formulaTiempo             String?
}

model ConfiguracionEntrenamiento {
  id                String                 @id @unique
  nombre            String
  urlImagen         String?
  costoArmas        Int
  costoMunicion     Int
  costoDolares      Int
  duracion          Int
  puntos            Float
  EntrenamientoUsuario  EntrenamientoUsuario[]
}

model ConfiguracionTropa {
  id            String         @id @unique
  nombre        String
  urlImagen     String?
  descripcion   String
  costoArmas    Int
  costoMunicion Int
  costoDolares  Int
  duracion      Int
  puntos        Float
  ataque        Int
  defensa       Int
  capacidad     Int
  velocidad     Int
  salario       Int
  requisitos    String[]
  bonusAtaque   String[]
  bonusDefensa  String[]
  TropaUsuario      TropaUsuario[]
}
