// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String                   @id @default(cuid())
  name           String
  username       String                   @unique
  password       String
  title          String?
  avatarUrl      String?
  propiedades    Propiedad[]
  entrenamientos EntrenamientoUsuario[]
  puntuacion     PuntuacionUsuario?
  misiones       ColaMisiones[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

model Propiedad {
  id                  String                 @id @default(cuid())
  userId              String
  nombre              String
  ciudad              Int
  barrio              Int
  edificio            Int
  armas               Float                  @default(0)
  municion            Float                  @default(0)
  alcohol             Float                  @default(0)
  dolares             Float                  @default(0)
  ultimaActualizacion DateTime               @default(now())
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitaciones        HabitacionUsuario[]
  tropas              TropaUsuario[]
  colaConstruccion    ColaConstruccion[]
  colaReclutamiento   ColaReclutamiento?

  @@unique([ciudad, barrio, edificio])
}

model HabitacionUsuario {
  id                           String                @id @default(cuid())
  propiedadId                  String
  configuracionHabitacionId    String
  nivel                        Int
  propiedad                    Propiedad             @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion                ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id])

  @@unique([propiedadId, configuracionHabitacionId])
}

model EntrenamientoUsuario {
  id                           String                     @id @default(cuid())
  userId                       String
  configuracionEntrenamientoId String
  nivel                        Int
  user                         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuracion                ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id])

  @@unique([userId, configuracionEntrenamientoId])
}

model TropaUsuario {
  id                       String           @id @default(cuid())
  propiedadId              String
  configuracionTropaId     String
  cantidad                 Int
  propiedad                Propiedad        @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion            ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id])

  @@unique([propiedadId, configuracionTropaId])
}

model PuntuacionUsuario {
  id                    String @id @default(cuid())
  userId                String @unique
  puntosHabitaciones    Float
  puntosTropas          Float
  puntosEntrenamientos  Float
  puntosTotales         Float
  user                  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ColaConstruccion {
  id                String     @id @default(cuid())
  propiedadId       String
  habitacionId      String
  nivelDestino      Int
  duracion          Int
  fechaInicio       DateTime?
  fechaFinalizacion DateTime?
  createdAt         DateTime   @default(now())
  propiedad         Propiedad  @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
}

model ColaReclutamiento {
  id                String             @id @default(cuid())
  propiedadId       String             @unique
  tropaId           String
  cantidad          Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime
  propiedad         Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  tropaConfig       ConfiguracionTropa @relation(fields: [tropaId], references: [id])
}

model ColaMisiones {
  id                String     @id @default(cuid())
  userId            String
  propiedadOrigenId String?
  tipoMision        TipoMision
  tropas            String // JSON string de las tropas
  origenCiudad      Int
  origenBarrio      Int
  origenEdificio    Int
  destinoCiudad     Int
  destinoBarrio     Int
  destinoEdificio   Int
  fechaInicio       DateTime
  fechaLlegada      DateTime
  fechaRegreso      DateTime?
  velocidadFlota    Int
  duracionViaje     Int
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TipoMision {
  ATAQUE
  OCUPAR
  DEFENDER
  TRANSPORTE
  ESPIONAJE
  REGRESO
}

// --- TABLAS DE CONFIGURACIÓN ---

model ConfiguracionHabitacion {
  id                 String                         @id @unique
  nombre             String
  descripcion        String                         @db.Text
  urlImagen          String
  costoArmas         Int
  costoMunicion      Int
  costoDolares       Int
  duracion           Int
  produccionBase     Float
  produccionRecurso  String?
  puntos             Float
  habitaciones       HabitacionUsuario[]
  escalado           ConfiguracionEscaladoHabitacion?
}

model ConfiguracionEscaladoHabitacion {
  id                       String                  @id @default(cuid())
  habitacionId             String                  @unique
  factorCostoPorNivel      Float
  produccionRecurso        String?
  formulaAumentoProduccion String?
  habitacion               ConfiguracionHabitacion @relation(fields: [habitacionId], references: [id], onDelete: Cascade)
}

model ConfiguracionEntrenamiento {
  id             String                   @id @unique
  nombre         String
  urlImagen      String
  costoArmas     Int
  costoMunicion  Int
  costoDolares   Int
  duracion       Int
  puntos         Float
  entrenamientos EntrenamientoUsuario[]
}

model ConfiguracionTropa {
  id            String              @id @unique
  nombre        String
  urlImagen     String
  descripcion   String              @db.Text
  costoArmas    Int
  costoMunicion Int
  costoDolares  Int
  duracion      Int
  puntos        Float
  ataque        Int
  defensa       Int
  capacidad     Int
  velocidad     Int
  salario       Int
  tipo          TipoTropa
  requisitos    String[]
  bonusAtaque   String[]
  bonusDefensa  String[]
  tropas        TropaUsuario[]
  colas         ColaReclutamiento[]
}

enum TipoTropa {
  ATAQUE
  DEFENSA
  OCUPAR
  ESPIONAJE
  TRANSPORTE
}
