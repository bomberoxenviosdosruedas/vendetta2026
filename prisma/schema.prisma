// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// -------------------
// Modelos de Configuración (Datos Maestros del Juego)
// -------------------

model ConfiguracionHabitacion {
  id                 String   @id
  nombre             String
  descripcion        String
  urlImagen          String
  costoArmas         Int
  costoMunicion      Int
  costoDolares       Int
  duracion           Int
  produccionBase     Float
  produccionRecurso  String?
  puntos             Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  habitaciones       HabitacionUsuario[]
  requirements       RoomRequirement[]   @relation("requiredFor")
  requiredFor        RoomRequirement[]   @relation("requirements")
}

model RoomRequirement {
  id             String                @id @default(cuid())
  roomId         String
  requiredRoomId String
  requiredLevel  Int
  room           ConfiguracionHabitacion @relation("requiredFor", fields: [roomId], references: [id], onDelete: Cascade)
  requiredRoom   ConfiguracionHabitacion @relation("requirements", fields: [requiredRoomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([requiredRoomId])
}


model ConfiguracionEntrenamiento {
  id                   String                 @id
  nombre               String
  urlImagen            String
  costoArmas           Int
  costoMunicion        Int
  costoDolares         Int
  duracion             Int
  puntos               Float
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  entrenamientos       EntrenamientoUsuario[]
  requirements         TrainingRequirement[]  @relation("requiredFor")
  requiredFor          TrainingRequirement[]  @relation("requirements")
  colaEntrenamientos   ColaEntrenamiento[]
}

model TrainingRequirement {
  id                   String                     @id @default(cuid())
  trainingId           String
  requiredTrainingId   String
  requiredLevel        Int
  training             ConfiguracionEntrenamiento @relation("requiredFor", fields: [trainingId], references: [id], onDelete: Cascade)
  requiredTraining     ConfiguracionEntrenamiento @relation("requirements", fields: [requiredTrainingId], references: [id], onDelete: Cascade)

  @@index([trainingId])
  @@index([requiredTrainingId])
}


model ConfiguracionTropa {
  id                  String                   @id
  nombre              String
  urlImagen           String
  descripcion         String
  costoArmas          Int
  costoMunicion       Int
  costoDolares        Int
  duracion            Int
  puntos              Float
  ataque              Int
  defensa             Int
  capacidad           Int
  velocidad           BigInt
  salario             Int
  tipo                TipoTropa
  requisitos          String[]
  bonusAtaque         String[]
  bonusDefensa        String[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  tropas              TropaUsuario[]
  tropasSeguridad     TropaSeguridadUsuario[]
  colaReclutamiento   ColaReclutamiento[]
  bonusContrincante   TropaBonusContrincante[] @relation("atacante")
  bonificadoPor       TropaBonusContrincante[] @relation("defensor")
}

model TropaBonusContrincante {
  id                String             @id @default(cuid())
  tropaAtacanteId   String
  tropaDefensoraId  String
  factorPrioridad   Float
  tropaAtacante     ConfiguracionTropa @relation("atacante", fields: [tropaAtacanteId], references: [id], onDelete: Cascade)
  tropaDefensora    ConfiguracionTropa @relation("defensor", fields: [tropaDefensoraId], references: [id], onDelete: Cascade)

  @@unique([tropaAtacanteId, tropaDefensoraId])
}

model PoderAtaque {
  id          String @id @default(cuid())
  propiedades Int
  honor       Int
  modificador Int

  @@unique([propiedades, honor])
}

// -------------------
// Modelos de Usuario y Progreso
// -------------------

model User {
  id               String             @id @default(cuid())
  name             String
  username         String             @unique
  password         String
  title            String?
  avatarUrl        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  lastSeen         DateTime           @default(now())
  propiedades      Propiedad[]
  puntuacion       PuntuacionUsuario?
  entrenamientos   EntrenamientoUsuario[]
  misiones         ColaMisiones[]
  colaEntrenamientos ColaEntrenamiento[]
  loginHistory     LoginHistory[]
  familyMember     FamilyMember?
  sentMessages     Message[]          @relation("Sender")
  receivedMessages Message[]          @relation("Recipient")
  FamilyInvitation FamilyInvitation[]
}

model SuperUser {
  id       String @id @default(cuid())
  username String @unique
  password String
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String
  userAgent String
  loginTime DateTime @default(now())
}

model Propiedad {
  id                   String                  @id @default(cuid())
  userId               String
  nombre               String
  ciudad               Int
  barrio               Int
  edificio             Int
  armas                Float
  municion             Float
  alcohol              Float
  dolares              Float
  ultimaActualizacion  DateTime                @default(now())
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitaciones         HabitacionUsuario[]
  TropaUsuario         TropaUsuario[]
  TropaSeguridadUsuario TropaSeguridadUsuario[]
  colaConstruccion     ColaConstruccion[]
  colaReclutamiento    ColaReclutamiento?
  misionesOrigen       ColaMisiones[]
  colaEntrenamientos   ColaEntrenamiento[]

  @@unique([ciudad, barrio, edificio])
}

model HabitacionUsuario {
  id                        String                @id @default(cuid())
  propiedadId               String
  configuracionHabitacionId String
  nivel                     Int
  propiedad                 Propiedad             @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion             ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id], onDelete: Cascade)

  @@unique([propiedadId, configuracionHabitacionId])
}

model EntrenamientoUsuario {
  id                           String                     @id @default(cuid())
  userId                       String
  configuracionEntrenamientoId String
  nivel                        Int
  user                         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuracion                ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id], onDelete: Cascade)

  @@unique([userId, configuracionEntrenamientoId])
}

model TropaUsuario {
  id                     String             @id @default(cuid())
  propiedadId            String
  configuracionTropaId   String
  cantidad               Int
  propiedad              Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion          ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id], onDelete: Cascade)

  @@unique([propiedadId, configuracionTropaId])
}

model TropaSeguridadUsuario {
  id                     String             @id @default(cuid())
  propiedadId            String
  configuracionTropaId   String
  cantidad               Int
  propiedad              Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion          ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id], onDelete: Cascade)

  @@unique([propiedadId, configuracionTropaId])
}


model PuntuacionUsuario {
  id                   String   @id @default(cuid())
  userId               String   @unique
  puntosHabitaciones   Float
  puntosTropas         Float
  puntosEntrenamientos Float
  puntosTotales        Float
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------------------
// Modelos de Colas de Eventos
// -------------------

model ColaConstruccion {
  id                String     @id @default(cuid())
  propiedadId       String
  habitacionId      String
  nivelDestino      Int
  duracion          Int
  fechaInicio       DateTime?
  fechaFinalizacion DateTime?
  propiedad         Propiedad  @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())
}

model ColaReclutamiento {
  id                String             @id @default(cuid())
  propiedadId       String             @unique
  tropaId           String
  cantidad          Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime
  propiedad         Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  tropaConfig       ConfiguracionTropa @relation(fields: [tropaId], references: [id], onDelete: Cascade)
}

model ColaMisiones {
  id                String   @id @default(cuid())
  userId            String
  propiedadOrigenId String
  tipoMision        String
  tropas            String // JSON string de las tropas
  origenCiudad      Int
  origenBarrio      Int
  origenEdificio    Int
  destinoCiudad     Int
  destinoBarrio     Int
  destinoEdificio   Int
  fechaInicio       DateTime
  fechaLlegada      DateTime
  fechaRegreso      DateTime?
  velocidadFlota    BigInt
  duracionViaje     Int

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  propiedadOrigen   Propiedad @relation(fields: [propiedadOrigenId], references: [id], onDelete: Cascade)
}

model ColaEntrenamiento {
  id                String                     @id @default(cuid())
  userId            String
  propiedadId       String
  entrenamientoId   String
  nivelDestino      Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  propiedad         Propiedad                  @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  entrenamiento     ConfiguracionEntrenamiento @relation(fields: [entrenamientoId], references: [id], onDelete: Cascade)

  @@unique([userId, entrenamientoId])
  @@unique([propiedadId])
}

// ----------
// Social
// ----------
model Family {
  id          String             @id @default(cuid())
  name        String             @unique
  tag         String             @unique
  description String?
  avatarUrl   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  members     FamilyMember[]
  invitations FamilyInvitation[]
}

model FamilyMember {
  id        String   @id @default(cuid())
  userId    String   @unique
  familyId  String
  role      FamilyRole @default(MEMBER)
  joinedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

enum FamilyRole {
  LEADER
  CO_LEADER
  MEMBER
}

model FamilyInvitation {
  id        String           @id @default(cuid())
  familyId  String
  userId    String
  type      InvitationType   @default(INVITATION)
  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  expiresAt DateTime         @default(dbgenerated("NOW() + interval '7 day'"))
  family    Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
}

enum InvitationType {
  INVITATION
  REQUEST
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model Message {
  id          String          @id @default(cuid())
  senderId    String?
  recipientId String
  subject     String
  content     String
  isRead      Boolean         @default(false)
  category    MessageCategory @default(JUGADOR)
  createdAt   DateTime        @default(now())

  sender    User? @relation("Sender", fields: [senderId], references: [id], onDelete: SetNull)
  recipient User  @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
}

enum MessageCategory {
  JUGADOR
  BATALLA
  CONSTRUCCION
  SISTEMA
}

enum TipoTropa {
  ATAQUE
  DEFENSA
  ESPIONAJE
  OCUPAR
  TRANSPORTE
}
