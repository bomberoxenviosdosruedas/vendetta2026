// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SuperUser {
  id       String @id @default(cuid())
  username String @unique
  password String
}

model User {
  id               String               @id @default(cuid())
  name             String
  username         String               @unique
  password         String
  title            String?
  avatarUrl        String?
  lastSeen         DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  propiedades      Propiedad[]
  puntuacion       PuntuacionUsuario?
  entrenamientos   EntrenamientoUsuario[]
  misiones         ColaMisiones[]
  colaEntrenamientos ColaEntrenamiento[]
  loginHistory     LoginHistory[]
  familyMember     FamilyMember?
  sentMessages     Message[]            @relation("SentMessages")
  receivedMessages Message[]            @relation("ReceivedMessages")
  FamilyInvitation FamilyInvitation[]
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String
  userAgent String
  loginTime DateTime @default(now())

  @@index([userId])
}

model Propiedad {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  nombre              String
  ciudad              Int
  barrio              Int
  edificio            Int
  armas               Float                @default(10000)
  municion            Float                @default(10000)
  alcohol             Float                @default(10000)
  dolares             Float                @default(10000)
  ultimaActualizacion DateTime             @default(now())
  habitaciones        HabitacionUsuario[]
  colaConstruccion    ColaConstruccion[]
  colaReclutamiento   ColaReclutamiento?
  misiones            ColaMisiones[]       @relation("MisionesDesdePropiedad")
  TropaUsuario        TropaUsuario[]
  TropaSeguridadUsuario TropaSeguridadUsuario[]
  colaEntrenamiento   ColaEntrenamiento[]

  @@unique([ciudad, barrio, edificio])
  @@index([userId])
}

model HabitacionUsuario {
  id                        String                @id @default(cuid())
  propiedadId               String
  propiedad                 Propiedad             @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracionHabitacionId String
  configuracion             ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id], onDelete: Cascade)
  nivel                     Int                   @default(0)

  @@unique([propiedadId, configuracionHabitacionId])
}

model EntrenamientoUsuario {
  id                           String                     @id @default(cuid())
  userId                       String
  user                         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuracionEntrenamientoId String
  configuracion                ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id], onDelete: Cascade)
  nivel                        Int                        @default(0)

  @@unique([userId, configuracionEntrenamientoId])
}

model TropaUsuario {
  id                     String             @id @default(cuid())
  propiedadId            String
  propiedad              Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracionTropaId   String
  configuracion          ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id], onDelete: Cascade)
  cantidad               Int

  @@unique([propiedadId, configuracionTropaId])
}

model TropaSeguridadUsuario {
  id                     String             @id @default(cuid())
  propiedadId            String
  propiedad              Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracionTropaId   String
  configuracion          ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id], onDelete: Cascade)
  cantidad               Int

  @@unique([propiedadId, configuracionTropaId])
}

model PuntuacionUsuario {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puntosHabitaciones   Float
  puntosTropas         Float
  puntosEntrenamientos Float
  puntosTotales        Float
  updatedAt            DateTime @updatedAt
}

model ConfiguracionHabitacion {
  id                 String              @id
  nombre             String
  descripcion        String
  urlImagen          String
  costoArmas         Int
  costoMunicion      Int
  costoDolares       Int
  duracion           Int
  produccionBase     Float
  produccionRecurso  String?
  puntos             Float
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  HabitacionUsuario  HabitacionUsuario[]
  requirements       RoomRequirement[]   @relation("RequiredFor")
  requiredBy         RoomRequirement[]   @relation("RequirementOf")
}

model RoomRequirement {
  id             String                @id @default(cuid())
  roomId         String
  requiredRoomId String
  room           ConfiguracionHabitacion @relation("RequiredFor", fields: [roomId], references: [id], onDelete: Cascade)
  requiredRoom   ConfiguracionHabitacion @relation("RequirementOf", fields: [requiredRoomId], references: [id], onDelete: Cascade)
  requiredLevel  Int

  @@unique([roomId, requiredRoomId])
}

model ConfiguracionEntrenamiento {
  id                    String                   @id
  nombre                String
  urlImagen             String
  costoArmas            Int
  costoMunicion         Int
  costoDolares          Int
  duracion              Int
  puntos                Float
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  EntrenamientoUsuario  EntrenamientoUsuario[]
  colaEntrenamiento     ColaEntrenamiento[]
  requirements          TrainingRequirement[]    @relation("RequiredFor")
  requiredBy            TrainingRequirement[]    @relation("RequirementOf")
}

model TrainingRequirement {
  id                 String                     @id @default(cuid())
  trainingId         String
  requiredTrainingId String
  training           ConfiguracionEntrenamiento @relation("RequiredFor", fields: [trainingId], references: [id], onDelete: Cascade)
  requiredTraining   ConfiguracionEntrenamiento @relation("RequirementOf", fields: [requiredTrainingId], references: [id], onDelete: Cascade)
  requiredLevel      Int

  @@unique([trainingId, requiredTrainingId])
}

model ConfiguracionTropa {
  id                    String                  @id
  nombre                String
  urlImagen             String
  descripcion           String
  costoArmas            Int
  costoMunicion         Int
  costoDolares          Int
  duracion              Int
  puntos                Float
  ataque                Int
  defensa               Int
  capacidad             Int
  velocidad             BigInt
  salario               Int
  tipo                  TipoTropa
  requisitos            String[]
  bonusAtaque           String[]
  bonusDefensa          String[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  TropaUsuario          TropaUsuario[]
  TropaSeguridadUsuario TropaSeguridadUsuario[]
  colaReclutamiento     ColaReclutamiento[]
  bonusContrincante     TropaBonusContrincante[]  @relation("Atacante")
  defensaBonus          TropaBonusContrincante[]  @relation("Defensor")
}

model TropaBonusContrincante {
  id                 String             @id @default(cuid())
  tropaAtacanteId    String
  tropaDefensoraId   String
  tropaAtacante      ConfiguracionTropa @relation("Atacante", fields: [tropaAtacanteId], references: [id], onDelete: Cascade)
  tropaDefensora     ConfiguracionTropa @relation("Defensor", fields: [tropaDefensoraId], references: [id], onDelete: Cascade)
  factorPrioridad    Float

  @@unique([tropaAtacanteId, tropaDefensoraId])
}

enum TipoTropa {
  ATAQUE
  DEFENSA
  ESPIONAJE
  TRANSPORTE
  OCUPAR
}

model ColaConstruccion {
  id                String    @id @default(cuid())
  propiedadId       String
  propiedad         Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  habitacionId      String
  nivelDestino      Int
  duracion          Int
  fechaInicio       DateTime?
  fechaFinalizacion DateTime?
  createdAt         DateTime  @default(now())

  @@index([propiedadId])
}

model ColaReclutamiento {
  id                String             @id @default(cuid())
  propiedadId       String             @unique
  propiedad         Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  tropaId           String
  tropaConfig       ConfiguracionTropa @relation(fields: [tropaId], references: [id], onDelete: Cascade)
  cantidad          Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime

  @@index([propiedadId])
}

model ColaMisiones {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  propiedadOrigenId String
  propiedadOrigen   Propiedad  @relation("MisionesDesdePropiedad", fields: [propiedadOrigenId], references: [id], onDelete: Cascade)
  tipoMision        String
  tropas            String
  origenCiudad      Int
  origenBarrio      Int
  origenEdificio    Int
  destinoCiudad     Int
  destinoBarrio     Int
  destinoEdificio   Int
  fechaInicio       DateTime
  fechaLlegada      DateTime
  fechaRegreso      DateTime?
  velocidadFlota    Float
  duracionViaje     Int

  @@index([userId])
}

model ColaEntrenamiento {
  id                String                     @id @default(cuid())
  userId            String
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  propiedadId       String
  propiedad         Propiedad                  @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  entrenamientoId   String
  entrenamiento     ConfiguracionEntrenamiento @relation(fields: [entrenamientoId], references: [id])
  nivelDestino      Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime

  @@index([userId])
  @@index([propiedadId])
}

model Family {
  id           String             @id @default(cuid())
  name         String             @unique
  tag          String             @unique
  description  String?
  avatarUrl    String?
  members      FamilyMember[]
  invitations  FamilyInvitation[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model FamilyMember {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  family    Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  role      FamilyRole
  joinedAt  DateTime  @default(now())

  @@index([familyId])
}

enum FamilyRole {
  LEADER
  CO_LEADER
  MEMBER
}

model FamilyInvitation {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([familyId, userId])
}

model Message {
  id          String          @id @default(cuid())
  senderId    String?
  sender      User?           @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)
  recipientId String
  recipient   User            @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  subject     String
  content     String
  isRead      Boolean         @default(false)
  category    MessageCategory @default(JUGADOR)
  createdAt   DateTime        @default(now())

  @@index([recipientId])
}

enum MessageCategory {
  JUGADOR
  BATALLA
  CONSTRUCCION
  SISTEMA
}

model PoderAtaque {
  id          String @id @default(cuid())
  propiedades Int
  honor       Int
  modificador Int

  @@unique([propiedades, honor])
}
