
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String          @id @default(cuid())
  name             String
  username         String          @unique
  password         String
  title            String?
  avatarUrl        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  progreso         ProgresoUsuario?
  propiedades      Propiedad[]
  entrenamientos   EntrenamientoUsuario[]
  tropas           TropaUsuario[]
  puntuacion       PuntuacionUsuario?
  misiones         ColaMisiones[]
}

model ProgresoUsuario {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id])
  userId            String   @unique
  dolares           Float    @default(0)
  armas             Float    @default(0)
  municion          Float    @default(0)
  alcohol           Float    @default(0)
  ultimaActualizacion DateTime @default(now())
}

model PuntuacionUsuario {
  id                   String   @id @default(cuid())
  user                 User     @relation(fields: [userId], references: [id])
  userId               String   @unique
  puntosHabitaciones   Float    @default(0)
  puntosTropas         Float    @default(0)
  puntosEntrenamientos Float    @default(0)
  puntosTotales        Float    @default(0)
  ultimaActualizacion  DateTime @default(now())
}

model Propiedad {
  id                String            @id @default(cuid())
  user              User              @relation(fields: [userId], references: [id])
  userId            String
  nombre            String
  ciudad            Int
  barrio            Int
  edificio          Int
  habitaciones      HabitacionUsuario[]
  colaConstruccion  ColaConstruccion[]
  colaReclutamiento ColaReclutamiento?

  @@unique([ciudad, barrio, edificio])
}

model HabitacionUsuario {
  id                        String                @id @default(cuid())
  propiedad                 Propiedad             @relation(fields: [propiedadId], references: [id])
  propiedadId               String
  configuracion             ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id])
  configuracionHabitacionId String
  nivel                     Int                   @default(0)

  @@unique([propiedadId, configuracionHabitacionId])
}

model EntrenamientoUsuario {
  id                             String                     @id @default(cuid())
  user                           User                       @relation(fields: [userId], references: [id])
  userId                         String
  configuracion                  ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id])
  configuracionEntrenamientoId   String
  nivel                          Int                        @default(0)

  @@unique([userId, configuracionEntrenamientoId])
}

enum TipoTropa {
  ATAQUE
  DEFENSA
  OCUPAR
}

model TropaUsuario {
  id                   String             @id @default(cuid())
  user                 User               @relation(fields: [userId], references: [id])
  userId               String
  configuracion        ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id])
  configuracionTropaId String
  cantidad             Int                @default(0)

  @@unique([userId, configuracionTropaId])
}

// --- COLAS DE EVENTOS ---
model ColaConstruccion {
  id                String    @id @default(cuid())
  propiedad         Propiedad @relation(fields: [propiedadId], references: [id])
  propiedadId       String
  habitacionId      String
  nivelDestino      Int
  fechaInicio       DateTime?
  fechaFinalizacion DateTime?
  duracion          Int
  createdAt         DateTime  @default(now())
}

model ColaReclutamiento {
  id                String             @id @default(cuid())
  propiedad         Propiedad          @relation(fields: [propiedadId], references: [id])
  propiedadId       String             @unique
  tropaConfig       ConfiguracionTropa @relation(fields: [tropaId], references: [id])
  tropaId           String
  cantidad          Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime
}

model ColaMisiones {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id])
  userId            String
  tipoMision        String
  tropas            Json
  origenCiudad      Int
  origenBarrio      Int
  origenEdificio    Int
  destinoCiudad     Int
  destinoBarrio     Int
  destinoEdificio   Int
  fechaLlegada      DateTime
  fechaRegreso      DateTime
  createdAt         DateTime @default(now())
}


// --- TABLAS DE CONFIGURACIÓN ---
model ConfiguracionHabitacion {
  id                 String                           @id @unique
  nombre             String
  descripcion        String
  urlImagen          String
  costoArmas         Int
  costoMunicion      Int
  costoDolares       Int
  duracion           Int
  produccionBase     Int                              @default(0)
  produccionRecurso  String?
  puntos             Float
  habitaciones       HabitacionUsuario[]
  escalado           ConfiguracionEscaladoHabitacion?
}

model ConfiguracionEscaladoHabitacion {
  id                   String                   @id @default(cuid())
  habitacion           ConfiguracionHabitacion  @relation(fields: [habitacionId], references: [id])
  habitacionId         String                   @unique
  factorCostoPorNivel  Float                    @default(1.2)
}

model ConfiguracionEntrenamiento {
  id             String                   @id @unique
  nombre         String
  urlImagen      String
  costoArmas     Int
  costoMunicion  Int
  costoDolares   Int
  duracion       Int
  puntos         Float
  entrenamientos EntrenamientoUsuario[]
}

model ConfiguracionTropa {
  id            String               @id @unique
  nombre        String
  urlImagen     String
  descripcion   String
  costoArmas    Int
  costoMunicion Int
  costoDolares  Int
  duracion      Int
  puntos        Float
  ataque        Int
  defensa       Int
  capacidad     Int
  velocidad     Int
  salario       Int
  tipo          TipoTropa
  requisitos    String[]
  bonusAtaque   String[]
  bonusDefensa  String[]
  tropas        TropaUsuario[]
  colas         ColaReclutamiento[]
}
