// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ---------------------
// Modelos de Identidad y Progreso
// ---------------------

model User {
  id              String        @id @default(cuid())
  name            String
  username        String        @unique
  password        String
  title           String?
  avatarUrl       String?
  createdAt       DateTime      @default(now())

  // Relaciones
  progreso        ProgresoUsuario?
  habitaciones    HabitacionUsuario[]
  entrenamientos  EntrenamientoUsuario[]
  tropas          TropaUsuario[]

  @@map("users")
}

model ProgresoUsuario {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  
  dolares             Float    @default(0)
  armas               Float    @default(0)
  municion            Float    @default(0)
  alcohol             Float    @default(0)
  
  ultimaActualizacion DateTime @updatedAt

  @@map("user_progress")
}

// ---------------------
// Modelos de Enlace (Progreso del Usuario)
// ---------------------

model HabitacionUsuario {
  userId                      String
  user                        User     @relation(fields: [userId], references: [id])
  configuracionHabitacionId   String
  configuracion               ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id])
  nivel                       Int      @default(0)
  
  @@id([userId, configuracionHabitacionId])
  @@map("user_rooms")
}

model EntrenamientoUsuario {
  userId                        String
  user                          User     @relation(fields: [userId], references: [id])
  configuracionEntrenamientoId  String
  configuracion                 ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id])
  nivel                         Int      @default(0)
  
  @@id([userId, configuracionEntrenamientoId])
  @@map("user_trainings")
}

model TropaUsuario {
  userId                String
  user                  User     @relation(fields: [userId], references: [id])
  configuracionTropaId  String
  configuracion         ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id])
  cantidad              Int      @default(0)
  
  @@id([userId, configuracionTropaId])
  @@map("user_troops")
}


// ---------------------
// Modelos de Configuración (Datos estáticos del juego)
// ---------------------

model ConfiguracionHabitacion {
  id            String   @id
  nombre        String
  descripcion   String
  urlImagen     String
  costoArmas    Int
  costoMunicion Int
  costoDolares  Int
  duracion      Int
  produccion    Float
  puntos        Float
  
  usuarios      HabitacionUsuario[] // Relación inversa

  @@map("room_configurations")
}

model ConfiguracionEntrenamiento {
  id            String   @id
  nombre        String
  urlImagen     String
  costoArmas    Int
  costoMunicion Int
  costoDolares  Int
  duracion      Int
  puntos        Float

  usuarios      EntrenamientoUsuario[] // Relación inversa

  @@map("training_configurations")
}

model ConfiguracionTropa {
  id            String   @id
  nombre        String
  urlImagen     String
  descripcion   String
  costoArmas    Int
  costoMunicion Int
  costoDolares  Int
  duracion      Int
  puntos        Float
  ataque        Int
  defensa       Int
  capacidad     Int
  velocidad     Int
  salario       Int
  requisitos    String[]
  bonusAtaque   String[]
  bonusDefensa  String[]

  usuarios      TropaUsuario[] // Relación inversa

  @@map("troop_configurations")
}
