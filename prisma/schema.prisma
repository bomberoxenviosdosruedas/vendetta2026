// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id                String                 @id @default(cuid())
  name              String
  username          String                 @unique
  password          String
  title             String?
  avatarUrl         String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  propiedades       Propiedad[]
  puntuacion        PuntuacionUsuario?
  entrenamientos    EntrenamientoUsuario[]
  misiones          ColaMisiones[]
  familyMember      FamilyMember?
  familyInvitations FamilyInvitation[]
}

model Propiedad {
  id                  String              @id @default(cuid())
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  nombre              String
  ciudad              Int
  barrio              Int
  edificio            Int
  armas               Float               @default(0)
  municion            Float               @default(0)
  alcohol             Float               @default(0)
  dolares             Float               @default(0)
  ultimaActualizacion DateTime            @default(now())
  habitaciones        HabitacionUsuario[]
  colaConstruccion    ColaConstruccion[]
  colaReclutamiento   ColaReclutamiento?
  misionesOrigen      ColaMisiones[]      @relation("MisionesOrigen")
  misionesDestino     ColaMisiones[]      @relation("MisionesDestino")
  TropaUsuario        TropaUsuario[]

  @@unique([ciudad, barrio, edificio])
}

model HabitacionUsuario {
  id                        String                  @id @default(cuid())
  propiedad                 Propiedad               @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId               String
  configuracion             ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id])
  configuracionHabitacionId String
  nivel                     Int                     @default(0)

  @@unique([propiedadId, configuracionHabitacionId])
}

model EntrenamientoUsuario {
  id                           String                     @id @default(cuid())
  user                         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                       String
  configuracion                ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id])
  configuracionEntrenamientoId String
  nivel                        Int                        @default(0)

  @@unique([userId, configuracionEntrenamientoId])
}

model TropaUsuario {
  id                   String             @id @default(cuid())
  propiedad            Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId          String
  configuracion        ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id])
  configuracionTropaId String
  cantidad             Int                @default(0)

  @@unique([propiedadId, configuracionTropaId])
}

model PuntuacionUsuario {
  id                   String @id @default(cuid())
  user                 User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String @unique
  puntosHabitaciones   Float
  puntosTropas         Float
  puntosEntrenamientos Float
  puntosTotales        Float
}

model ConfiguracionHabitacion {
  id                String                           @id
  nombre            String
  descripcion       String                           @db.Text
  urlImagen         String
  costoArmas        Int
  costoMunicion     Int
  costoDolares      Int
  duracion          Int // en segundos
  produccionBase    Int
  produccionRecurso String?
  puntos            Float
  habitaciones      HabitacionUsuario[]
  escalado          ConfiguracionEscaladoHabitacion?
  colaConstruccion  ColaConstruccion[]
}

model ConfiguracionEscaladoHabitacion {
  id                         String                  @id @default(cuid())
  configuracionHabitacion    ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id])
  configuracionHabitacionId  String                  @unique
  factor_costo_por_nivel     Float
  formula_aumento_produccion String?
  formula_tiempo             String
}

model ConfiguracionEntrenamiento {
  id             String                 @id
  nombre         String
  urlImagen      String
  costoArmas     Int
  costoMunicion  Int
  costoDolares   Int
  duracion       Int // en segundos
  puntos         Float
  entrenamientos EntrenamientoUsuario[]
}

model ConfiguracionTropa {
  id                String              @id
  nombre            String
  urlImagen         String
  descripcion       String              @db.Text
  costoArmas        Int
  costoMunicion     Int
  costoDolares      Int
  duracion          Int // en segundos
  puntos            Float
  ataque            Int
  defensa           Int
  capacidad         Int
  velocidad         Int
  salario           Int
  tipo              TipoTropa
  requisitos        Json
  bonusAtaque       Json
  bonusDefensa      Json
  tropas            TropaUsuario[]
  colaReclutamiento ColaReclutamiento[]
}

model ColaConstruccion {
  id                String                  @id @default(cuid())
  propiedad         Propiedad               @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId       String
  habitacion        ConfiguracionHabitacion @relation(fields: [habitacionId], references: [id])
  habitacionId      String
  nivelDestino      Int
  duracion          Int
  fechaInicio       DateTime?
  fechaFinalizacion DateTime?
  createdAt         DateTime                @default(now())
}

model ColaReclutamiento {
  id                String             @id @default(cuid())
  propiedad         Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId       String             @unique
  tropaConfig       ConfiguracionTropa @relation(fields: [tropaId], references: [id])
  tropaId           String
  cantidad          Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime
}

model ColaMisiones {
  id                 String     @id @default(cuid())
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  propiedadOrigen    Propiedad? @relation("MisionesOrigen", fields: [propiedadOrigenId], references: [id], onDelete: SetNull)
  propiedadOrigenId  String?
  propiedadDestino   Propiedad? @relation("MisionesDestino", fields: [propiedadDestinoId], references: [id], onDelete: SetNull)
  propiedadDestinoId String?

  tipoMision      String
  tropas          Json
  origenCiudad    Int
  origenBarrio    Int
  origenEdificio  Int
  destinoCiudad   Int
  destinoBarrio   Int
  destinoEdificio Int
  fechaInicio     DateTime
  fechaLlegada    DateTime
  fechaRegreso    DateTime?
  duracionViaje   Int
  velocidadFlota  Float
}

// --- Modelos de Familia ---

enum FamilyRole {
  LEADER
  CO_LEADER
  MEMBER
}

enum FamilyInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Family {
  id          String             @id @default(cuid())
  name        String             @unique
  tag         String             @unique
  description String?
  avatarUrl   String?
  members     FamilyMember[]
  invitations FamilyInvitation[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model FamilyMember {
  id        String     @id @default(cuid())
  role      FamilyRole @default(MEMBER)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String     @unique
  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId  String
  createdAt DateTime   @default(now())

  @@unique([userId, familyId])
}

model FamilyInvitation {
  id        String                 @id @default(cuid())
  family    Family                 @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId  String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  status    FamilyInvitationStatus @default(PENDING)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([familyId, userId])
}

enum TipoTropa {
  ATAQUE
  DEFENSA
  ESPIONAJE
  OCUPAR
}
