// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NONPOOLING") // uses a direct connection
}

model SuperUser {
  id       String @id @default(cuid())
  username String @unique
  password String
}

model User {
  id                 String               @id @default(cuid())
  name               String
  username           String               @unique
  password           String
  title              String?
  avatarUrl          String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  propiedades        Propiedad[]
  entrenamientos     EntrenamientoUsuario[]
  puntuacion         PuntuacionUsuario?
  colaEntrenamientos ColaEntrenamiento[]
  misiones           ColaMisiones[]
  familyMember       FamilyMember?
  sentMessages       Message[]            @relation("SentMessages")
  receivedMessages   Message[]            @relation("ReceivedMessages")
  invitations        FamilyInvitation[]
  loginHistory       LoginHistory[]
}

model Propiedad {
  id                    String                  @id @default(cuid())
  userId                String
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nombre                String
  ciudad                Int
  barrio                Int
  edificio              Int
  armas                 Float                   @default(10000)
  municion              Float                   @default(10000)
  alcohol               Float                   @default(10000)
  dolares               Float                   @default(10000)
  ultimaActualizacion   DateTime                @default(now())
  habitaciones          HabitacionUsuario[]
  TropaUsuario          TropaUsuario[]
  TropaSeguridadUsuario TropaSeguridadUsuario[]
  colaConstruccion      ColaConstruccion[]
  colaReclutamiento     ColaReclutamiento?
  misionesOrigen        ColaMisiones[]          @relation("MisionesOrigen")
  misionesDestino       ColaMisiones[]          @relation("MisionesDestino")
  colaEntrenamiento     ColaEntrenamiento[]

  @@unique([ciudad, barrio, edificio])
}

model HabitacionUsuario {
  id                        String                @id @default(cuid())
  propiedadId               String
  propiedad                 Propiedad             @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracionHabitacionId String
  configuracion             ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id])
  nivel                     Int                   @default(0)

  @@unique([propiedadId, configuracionHabitacionId])
}

model TropaUsuario {
  id                     String             @id @default(cuid())
  propiedadId            String
  propiedad              Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracionTropaId   String
  configuracion          ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id])
  cantidad               Int                @default(0)

  @@unique([propiedadId, configuracionTropaId])
}

model TropaSeguridadUsuario {
  id                     String             @id @default(cuid())
  propiedadId            String
  propiedad              Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracionTropaId   String
  configuracion          ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id])
  cantidad               Int                @default(0)
}

model EntrenamientoUsuario {
  id                           String                     @id @default(cuid())
  userId                       String
  user                         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuracionEntrenamientoId String
  configuracion                ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id])
  nivel                        Int                        @default(0)

  @@unique([userId, configuracionEntrenamientoId])
}

model PuntuacionUsuario {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puntosHabitaciones   Float
  puntosTropas         Float
  puntosEntrenamientos Float
  puntosTotales        Float
  updatedAt            DateTime @updatedAt
}

// --- COLAS DE EVENTOS ---
model ColaConstruccion {
  id                String    @id @default(cuid())
  propiedadId       String
  propiedad         Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  habitacionId      String
  nivelDestino      Int
  duracion          Int
  fechaInicio       DateTime?
  fechaFinalizacion DateTime?
  createdAt         DateTime  @default(now())
}

model ColaReclutamiento {
  id                String             @id @default(cuid())
  propiedadId       String             @unique
  propiedad         Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  tropaId           String
  tropaConfig       ConfiguracionTropa @relation(fields: [tropaId], references: [id])
  cantidad          Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime
}

model ColaEntrenamiento {
  id                String                     @id @default(cuid())
  userId            String
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  propiedadId       String
  propiedad         Propiedad                  @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  entrenamientoId   String
  entrenamiento     ConfiguracionEntrenamiento @relation(fields: [entrenamientoId], references: [id])
  nivelDestino      Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime
}

model ColaMisiones {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  propiedadOrigenId String
  propiedadOrigen   Propiedad @relation("MisionesOrigen", fields: [propiedadOrigenId], references: [id], onDelete: Cascade)
  tipoMision        String
  tropas            Json
  origenCiudad      Int
  origenBarrio      Int
  origenEdificio    Int
  destinoCiudad     Int
  destinoBarrio     Int
  destinoEdificio   Int
  propiedadDestino  Propiedad? @relation("MisionesDestino", fields: [destinoCiudad, destinoBarrio, destinoEdificio], references: [ciudad, barrio, edificio])
  fechaInicio       DateTime
  fechaLlegada      DateTime
  fechaRegreso      DateTime?
  velocidadFlota    Float
  duracionViaje     Int
}

// --- DATOS DE CONFIGURACIÓN ---
model ConfiguracionHabitacion {
  id                 String              @id
  nombre             String              @unique
  descripcion        String?
  urlImagen          String?
  costoArmas         Int
  costoMunicion      Int
  costoDolares       Int
  duracion           Int
  produccionBase     Float
  produccionRecurso  String?
  puntos             Float
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  habitaciones       HabitacionUsuario[]
  requirements       RoomRequirement[]   @relation("Room")
  requiredFor        RoomRequirement[]   @relation("RequiredRoom")
}

model ConfiguracionEntrenamiento {
  id                 String                 @id
  nombre             String                 @unique
  urlImagen          String?
  costoArmas         Int
  costoMunicion      Int
  costoDolares       Int
  duracion           Int
  puntos             Float
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  entrenamientos     EntrenamientoUsuario[]
  colaEntrenamientos ColaEntrenamiento[]
  requirements       TrainingRequirement[]  @relation("Training")
  requiredFor        TrainingRequirement[]  @relation("RequiredTraining")
}

model ConfiguracionTropa {
  id                       String                   @id
  nombre                   String                   @unique
  urlImagen                String?
  descripcion              String?
  costoArmas               Int
  costoMunicion            Int
  costoDolares             Int
  duracion                 Int
  puntos                   Float
  ataque                   Int
  defensa                  Int
  capacidad                Int
  velocidad                BigInt
  salario                  Int
  tipo                     TipoTropa
  requisitos               String[]
  bonusAtaque              String[]
  bonusDefensa             String[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  bonusContrincante        TropaBonusContrincante[] @relation("Atacante")
  TropaUsuario             TropaUsuario[]
  TropaSeguridadUsuario    TropaSeguridadUsuario[]
  colaReclutamiento        ColaReclutamiento[]
  bonusContrincanteDefensa TropaBonusContrincante[] @relation("Defensora")
}

model RoomRequirement {
  roomId           String
  requiredRoomId   String
  requiredLevel    Int
  room             ConfiguracionHabitacion @relation("Room", fields: [roomId], references: [id], onDelete: Cascade)
  requiredRoom     ConfiguracionHabitacion @relation("RequiredRoom", fields: [requiredRoomId], references: [id], onDelete: Cascade)

  @@id([roomId, requiredRoomId])
}

model TrainingRequirement {
  trainingId         String                     @id
  requiredTrainingId String
  requiredLevel      Int
  training           ConfiguracionEntrenamiento @relation("Training", fields: [trainingId], references: [id], onDelete: Cascade)
  requiredTraining   ConfiguracionEntrenamiento @relation("RequiredTraining", fields: [requiredTrainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, requiredTrainingId])
}

model TropaBonusContrincante {
  tropaAtacanteId  String
  tropaAtacante    ConfiguracionTropa @relation("Atacante", fields: [tropaAtacanteId], references: [id], onDelete: Cascade)
  tropaDefensoraId String
  tropaDefensora   ConfiguracionTropa @relation("Defensora", fields: [tropaDefensoraId], references: [id], onDelete: Cascade)
  factorPrioridad  Float

  @@id([tropaAtacanteId, tropaDefensoraId])
}

model PoderAtaque {
  id           String @id @default(cuid())
  propiedades  Int
  honor        Int
  modificador  Int

  @@unique([propiedades, honor])
}


// --- Modelos Sociales y de Comunicación ---
model Family {
  id          String             @id @default(cuid())
  name        String             @unique
  tag         String             @unique
  description String?
  avatarUrl   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  members     FamilyMember[]
  invitations FamilyInvitation[]
}

model FamilyMember {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  role      FamilyRole @default(MEMBER)
  joinedAt  DateTime   @default(now())
}

model FamilyInvitation {
  id        String         @id @default(cuid())
  familyId  String
  family    Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String         @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt DateTime       @default(now())
  expiresAt DateTime       @default(dbgenerated("NOW() + INTERVAL '7 days'"))

  @@unique([familyId, userId])
}

model Message {
  id          String          @id @default(cuid())
  senderId    String?
  sender      User?           @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)
  recipientId String
  recipient   User            @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  subject     String
  content     String
  isRead      Boolean         @default(false)
  category    MessageCategory @default(SISTEMA)
  createdAt   DateTime        @default(now())
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String
  userAgent String
  loginTime DateTime @default(now())
}


enum TipoTropa {
  ATAQUE
  DEFENSA
  ESPIONAJE
  TRANSPORTE
  OCUPAR
}

enum FamilyRole {
  LEADER
  CO_LEADER
  MEMBER
}

enum MessageCategory {
  SISTEMA
  JUGADOR
  BATALLA
  CONSTRUCCION
  ALIANZA
}
