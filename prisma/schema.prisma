// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SuperUser {
  id       String @id @default(cuid())
  username String @unique
  password String
}

model User {
  id                  String               @id @default(cuid())
  name                String
  username            String               @unique
  password            String
  title               String?
  avatarUrl           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  lastSeen            DateTime             @default(now())
  propiedades         Propiedad[]
  entrenamientos      EntrenamientoUsuario[]
  puntuacion          PuntuacionUsuario?
  misiones            ColaMisiones[]
  familyMember        FamilyMember?
  sentMessages        Message[]            @relation("SentMessages")
  receivedMessages    Message[]            @relation("ReceivedMessages")
  loginHistory        LoginHistory[]
  familyInvitations   FamilyInvitation[]
  colaEntrenamientos  ColaEntrenamiento[]

  @@index([username])
}

model Propiedad {
  id                   String                 @id @default(cuid())
  userId               String
  nombre               String
  ciudad               Int
  barrio               Int
  edificio             Int
  armas                Float                  @default(10000)
  municion             Float                  @default(10000)
  alcohol              Float                  @default(10000)
  dolares              Float                  @default(10000)
  ultimaActualizacion  DateTime               @default(now())
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitaciones         HabitacionUsuario[]
  TropaUsuario         TropaUsuario[]
  TropaSeguridadUsuario TropaSeguridadUsuario[]
  colaConstruccion     ColaConstruccion[]
  colaReclutamiento    ColaReclutamiento?
  misionesOrigen       ColaMisiones[]

  @@unique([ciudad, barrio, edificio])
}

model HabitacionUsuario {
  id                         String                  @id @default(cuid())
  propiedadId                String
  configuracionHabitacionId  String
  nivel                      Int                     @default(1)
  propiedad                  Propiedad               @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion              ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id])

  @@unique([propiedadId, configuracionHabitacionId])
}

model EntrenamientoUsuario {
  id                           String                     @id @default(cuid())
  userId                       String
  configuracionEntrenamientoId String
  nivel                        Int                        @default(0)
  user                         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuracion                ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id])

  @@unique([userId, configuracionEntrenamientoId])
}

model TropaUsuario {
  id                     String             @id @default(cuid())
  propiedadId            String
  configuracionTropaId   String
  cantidad               Int
  propiedad              Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion          ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id])

  @@unique([propiedadId, configuracionTropaId])
}

model TropaSeguridadUsuario {
  id                     String             @id @default(cuid())
  propiedadId            String
  configuracionTropaId   String
  cantidad               Int
  propiedad              Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion          ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id])

  @@unique([propiedadId, configuracionTropaId])
}

model PuntuacionUsuario {
  id                   String   @id @default(cuid())
  userId               String   @unique
  puntosHabitaciones   Float
  puntosTropas         Float
  puntosEntrenamientos Float
  puntosTotales        Float
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConfiguracionHabitacion {
  id                 String              @id @unique
  nombre             String
  descripcion        String
  urlImagen          String
  costoArmas         Int
  costoMunicion      Int
  costoDolares       Int
  duracion           Int
  produccionBase     Int
  produccionRecurso  String?
  puntos             Float
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  habitaciones       HabitacionUsuario[]
  requirements       RoomRequirement[]   @relation("RoomRequirements")
  requiredFor        RoomRequirement[]   @relation("RequiredForRoom")
}

model RoomRequirement {
  id             String                  @id @default(cuid())
  roomId         String
  requiredRoomId String
  requiredLevel  Int
  room           ConfiguracionHabitacion @relation("RoomRequirements", fields: [roomId], references: [id], onDelete: Cascade)
  requiredRoom   ConfiguracionHabitacion @relation("RequiredForRoom", fields: [requiredRoomId], references: [id], onDelete: Cascade)

  @@unique([roomId, requiredRoomId])
}

model ConfiguracionEntrenamiento {
  id                   String                 @id @unique
  nombre               String
  urlImagen            String
  costoArmas           Int
  costoMunicion        Int
  costoDolares         Int
  duracion             Int
  puntos               Float
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  entrenamientos       EntrenamientoUsuario[]
  colaEntrenamientos   ColaEntrenamiento[]
  requirements         TrainingRequirement[]  @relation("TrainingRequirements")
  requiredFor          TrainingRequirement[]  @relation("RequiredForTraining")
}

model TrainingRequirement {
  id                 String                     @id @default(cuid())
  trainingId         String
  requiredTrainingId String
  requiredLevel      Int
  training           ConfiguracionEntrenamiento @relation("TrainingRequirements", fields: [trainingId], references: [id], onDelete: Cascade)
  requiredTraining   ConfiguracionEntrenamiento @relation("RequiredForTraining", fields: [requiredTrainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, requiredTrainingId])
}

model ConfiguracionTropa {
  id                    String                  @id @unique
  nombre                String
  descripcion           String
  urlImagen             String
  costoArmas            Int
  costoMunicion         Int
  costoDolares          Int
  duracion              Int
  puntos                Float
  ataque                Int
  defensa               Int
  capacidad             Int
  velocidad             Int
  salario               Int
  tipo                  TipoTropa
  requisitos            String[]
  bonusAtaque           String[]
  bonusDefensa          String[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  tropas                TropaUsuario[]
  tropasSeguridad       TropaSeguridadUsuario[]
  colaReclutamiento     ColaReclutamiento[]
  bonusContrincante     TropaBonusContrincante[] @relation("Atacante")
  bonificadoContra      TropaBonusContrincante[] @relation("Defensor")
}

model TropaBonusContrincante {
    id                  String              @id @default(cuid())
    tropaAtacanteId     String
    tropaDefensoraId    String
    factorPrioridad     Float
    tropaAtacante       ConfiguracionTropa  @relation("Atacante", fields: [tropaAtacanteId], references: [id])
    tropaDefensora      ConfiguracionTropa  @relation("Defensor", fields: [tropaDefensoraId], references: [id])
    
    @@unique([tropaAtacanteId, tropaDefensoraId])
}

enum TipoTropa {
  ATAQUE
  DEFENSA
  ESPIONAJE
  OCUPAR
  TRANSPORTE
}

model ColaConstruccion {
  id                String    @id @default(cuid())
  propiedadId       String
  habitacionId      String
  nivelDestino      Int
  duracion          Int
  fechaInicio       DateTime?
  fechaFinalizacion DateTime?
  createdAt         DateTime  @default(now())
  propiedad         Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  @@index([propiedadId])
}

model ColaReclutamiento {
  id                String             @id @default(cuid())
  propiedadId       String             @unique
  tropaId           String
  cantidad          Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime
  propiedad         Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  tropaConfig       ConfiguracionTropa @relation(fields: [tropaId], references: [id])

  @@index([propiedadId])
}

model ColaEntrenamiento {
  id                String                      @id @default(cuid())
  userId            String
  propiedadId       String                      @unique
  entrenamientoId   String
  nivelDestino      Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime
  user              User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  propiedad         Propiedad                   @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  entrenamiento     ConfiguracionEntrenamiento  @relation(fields: [entrenamientoId], references: [id])

  @@index([userId])
  @@index([propiedadId])
}


model ColaMisiones {
  id                String    @id @default(cuid())
  userId            String
  propiedadOrigenId String
  tipoMision        String
  tropas            String // JSON string de las tropas
  origenCiudad      Int
  origenBarrio      Int
  origenEdificio    Int
  destinoCiudad     Int
  destinoBarrio     Int
  destinoEdificio   Int
  fechaInicio       DateTime
  fechaLlegada      DateTime
  fechaRegreso      DateTime?
  velocidadFlota    Float
  duracionViaje     Float

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  propiedadOrigen Propiedad @relation(fields: [propiedadOrigenId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model Family {
  id           String             @id @default(cuid())
  name         String             @unique
  tag          String             @unique
  description  String?
  avatarUrl    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  members      FamilyMember[]
  invitations  FamilyInvitation[]
}

model FamilyMember {
  id        String   @id @default(cuid())
  userId    String   @unique
  familyId  String
  role      FamilyRole @default(MEMBER)
  joinedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

enum FamilyRole {
  LEADER
  CO_LEADER
  MEMBER
}

model FamilyInvitation {
  id        String           @id @default(cuid())
  familyId  String
  userId    String
  type      InvitationType
  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  expiresAt DateTime?

  family    Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([familyId, userId]) // Can't invite/request if one already exists
}

enum InvitationType {
  INVITATION // Family invites user
  REQUEST    // User requests to join
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

model Message {
  id          String          @id @default(cuid())
  senderId    String?
  recipientId String
  subject     String
  content     String
  isRead      Boolean         @default(false)
  category    MessageCategory
  createdAt   DateTime        @default(now())

  sender      User?           @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)
  recipient   User            @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  
  @@index([recipientId])
}

enum MessageCategory {
  JUGADOR
  BATALLA
  CONSTRUCCION
  SISTEMA
}

model PoderAtaque {
    id          String @id @default(cuid())
    propiedades Int
    honor       Int
    modificador Int
    
    @@unique([propiedades, honor])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String
  userAgent String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
