// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------
// 👤 MODELOS DE IDENTIDAD Y PROGRESO
// -------------------------------------------

// Modelo de Usuario (solo identidad)
model Usuario {
  id            String  @id @default(cuid())
  nombre        String
  nombreUsuario String? @unique
  contrasena    String?
  titulo        String?
  urlAvatar     String?

  // Relaciones con los datos de juego del usuario
  progreso       ProgresoUsuario?
  habitaciones   HabitacionUsuario[]
  entrenamientos EntrenamientoUsuario[]
  tropas         TropaUsuario[]
  colaEventos    EventoJuego[]
}

// Modelo para los recursos y el estado del juego de cada usuario
model ProgresoUsuario {
  id        Int      @id @default(autoincrement())
  usuarioId String   @unique
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  // Recursos del jugador
  dolares   Float    @default(1000)
  armas     Float    @default(100)
  municion  Float    @default(500)
  alcohol   Float    @default(20)

  // Columna clave para la generación de recursos por tiempo
  ultimaActualizacion DateTime @default(now())
}

// -------------------------------------------
// 📈 MODELOS DE ENLACE (PROGRESO DEL JUGADOR)
// -------------------------------------------

// Almacena el nivel de cada habitación para un usuario
model HabitacionUsuario {
  id                        Int      @id @default(autoincrement())
  nivel                     Int      @default(0)
  usuarioId                 String
  configuracionHabitacionId String

  usuario                   Usuario                 @relation(fields: [usuarioId], references: [id])
  configuracionHabitacion   ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id])

  @@unique([usuarioId, configuracionHabitacionId])
}

// Almacena el nivel de cada entrenamiento para un usuario
model EntrenamientoUsuario {
  id                           Int      @id @default(autoincrement())
  nivel                        Int      @default(0)
  usuarioId                    String
  configuracionEntrenamientoId String

  usuario                      Usuario                    @relation(fields: [usuarioId], references: [id])
  configuracionEntrenamiento   ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id])

  @@unique([usuarioId, configuracionEntrenamientoId])
}

// Almacena la cantidad de cada tropa que tiene un usuario
model TropaUsuario {
  id                   Int      @id @default(autoincrement())
  cantidad             Int      @default(0)
  usuarioId            String
  configuracionTropaId String

  usuario              Usuario            @relation(fields: [usuarioId], references: [id])
  configuracionTropa   ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id])

  @@unique([usuarioId, configuracionTropaId])
}

// -------------------------------------------
// ⚙️ MODELOS DE CONFIGURACIÓN (REGLAS DEL JUEGO)
// -------------------------------------------

model ConfiguracionHabitacion {
  id            String  @id
  nombre        String
  descripcion   String
  urlImagen     String?
  costoArmas    Int
  costoMunicion Int
  costoDolares  Int
  duracion      Int
  produccion    Float
  puntos        Float

  // Relación inversa
  usuarios HabitacionUsuario[]
}

model ConfiguracionEntrenamiento {
  id            String  @id
  nombre        String
  urlImagen     String?
  costoArmas    Int
  costoMunicion Int
  costoDolares  Int
  duracion      Int
  puntos        Float

  // Relación inversa
  usuarios EntrenamientoUsuario[]
}

model ConfiguracionTropa {
  id             String   @id
  nombre         String
  urlImagen      String?
  descripcion    String
  costoArmas     Int
  costoMunicion  Int
  costoDolares   Int
  duracion       Int
  puntos         Float
  ataque         Int
  defensa        Int
  capacidad      Int
  velocidad      Int
  salario        Int
  requisitos     String[]
  bonusAtaque    String[]
  bonusDefensa   String[]

  // Relación inversa
  usuarios TropaUsuario[]
}

// -------------------------------------------
// 🕒 COLA DE EVENTOS (FUTURA IMPLEMENTACIÓN)
// -------------------------------------------

enum TipoEvento {
  MEJORA_HABITACION
  INICIO_ENTRENAMIENTO
  RECLUTAMIENTO_TROPA
}

model EventoJuego {
  id                 Int        @id @default(autoincrement())
  tipo               TipoEvento
  usuarioId          String
  entidadId          String    // ID de la habitación, tropa o entrenamiento
  nivelObjetivo      Int?      // Para mejoras de habitación/entrenamiento
  cantidad           Int?      // Para reclutamiento de tropas
  tiempoFinalizacion DateTime

  usuario Usuario @relation(fields: [usuarioId], references: [id])
}
