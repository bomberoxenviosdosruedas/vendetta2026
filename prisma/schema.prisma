// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                 @id @default(cuid())
  name               String
  username           String                 @unique
  password           String
  title              String?
  avatarUrl          String?
  puntuacion         PuntuacionUsuario?
  propiedades        Propiedad[]
  entrenamientos     EntrenamientoUsuario[]
  misiones           ColaMisiones[]
  familyMember       FamilyMember?
  sentMessages       Message[]              @relation("SentMessages")
  receivedMessages   Message[]              @relation("ReceivedMessages")
  colaEntrenamientos ColaEntrenamiento[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  FamilyInvitation FamilyInvitation[]
}

model PuntuacionUsuario {
  id                   String @id @default(cuid())
  user                 User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String @unique
  puntosHabitaciones   Float
  puntosTropas         Float
  puntosEntrenamientos Float
  puntosTotales        Float
}

model Propiedad {
  id                  String              @id @default(cuid())
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  nombre              String
  ciudad              Int
  barrio              Int
  edificio            Int
  armas               Float               @default(10000)
  municion            Float               @default(10000)
  alcohol             Float               @default(10000)
  dolares             Float               @default(10000)
  ultimaActualizacion DateTime            @default(now())
  habitaciones        HabitacionUsuario[]
  TropaUsuario        TropaUsuario[]
  colaConstruccion    ColaConstruccion[]
  colaReclutamiento   ColaReclutamiento?
  misionesOrigen      ColaMisiones[]      @relation("MisionesOrigen")
  colaEntrenamientos  ColaEntrenamiento[]

  @@unique([ciudad, barrio, edificio])
}

model HabitacionUsuario {
  id                        String                  @id @default(cuid())
  propiedad                 Propiedad               @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId               String
  configuracion             ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id], onDelete: Cascade)
  configuracionHabitacionId String
  nivel                     Int                     @default(1)

  @@unique([propiedadId, configuracionHabitacionId])
}

model EntrenamientoUsuario {
  id                           String                     @id @default(cuid())
  user                         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                       String
  configuracion                ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id], onDelete: Cascade)
  configuracionEntrenamientoId String
  nivel                        Int                        @default(0)

  @@unique([userId, configuracionEntrenamientoId])
}

model TropaUsuario {
  id                   String             @id @default(cuid())
  propiedad            Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId          String
  configuracion        ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id], onDelete: Cascade)
  configuracionTropaId String
  cantidad             Int                @default(0)

  @@unique([propiedadId, configuracionTropaId])
}

// --- COLAS ---

model ColaConstruccion {
  id                String    @id @default(cuid())
  propiedad         Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId       String
  habitacionId      String
  nivelDestino      Int
  duracion          Int
  fechaInicio       DateTime?
  fechaFinalizacion DateTime?
  createdAt         DateTime  @default(now())
}

model ColaReclutamiento {
  id                String             @id @default(cuid())
  propiedad         Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId       String             @unique
  tropaId           String
  tropaConfig       ConfiguracionTropa @relation(fields: [tropaId], references: [id], onDelete: Cascade)
  cantidad          Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime
}

model ColaEntrenamiento {
  id                String                     @id @default(cuid())
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  propiedad         Propiedad                  @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId       String
  entrenamiento     ConfiguracionEntrenamiento @relation(fields: [entrenamientoId], references: [id], onDelete: Cascade)
  entrenamientoId   String
  nivelDestino      Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime
}

model ColaMisiones {
  id                String     @id @default(cuid())
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  propiedadOrigen   Propiedad? @relation("MisionesOrigen", fields: [propiedadOrigenId], references: [id], onDelete: SetNull)
  propiedadOrigenId String?
  tipoMision        String
  tropas            String // JSON string de las tropas
  origenCiudad      Int
  origenBarrio      Int
  origenEdificio    Int
  destinoCiudad     Int
  destinoBarrio     Int
  destinoEdificio   Int
  fechaInicio       DateTime
  fechaLlegada      DateTime
  fechaRegreso      DateTime?
  velocidadFlota    Int
  duracionViaje     Int
}

// --- CONFIGURACIONES ---

model ConfiguracionHabitacion {
  id                String              @id
  nombre            String
  descripcion       String
  urlImagen         String
  costoArmas        Int
  costoMunicion     Int
  costoDolares      Int
  duracion          Int
  produccionBase    Float
  produccionRecurso String?
  puntos            Float
  HabitacionUsuario HabitacionUsuario[]
  requirements      RoomRequirement[]   @relation("requiredFor")
  requiredBy        RoomRequirement[]   @relation("requirements")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model RoomRequirement {
  room           ConfiguracionHabitacion @relation("requiredFor", fields: [roomId], references: [id], onDelete: Cascade)
  roomId         String
  requiredRoom   ConfiguracionHabitacion @relation("requirements", fields: [requiredRoomId], references: [id], onDelete: Cascade)
  requiredRoomId String
  requiredLevel  Int

  @@id([roomId, requiredRoomId])
}

model ConfiguracionEntrenamiento {
  id                   String                 @id
  nombre               String
  urlImagen            String
  costoArmas           Int
  costoMunicion        Int
  costoDolares         Int
  duracion             Int
  puntos               Float
  EntrenamientoUsuario EntrenamientoUsuario[]
  colaEntrenamientos   ColaEntrenamiento[]
  requirements         TrainingRequirement[]  @relation("requiredFor")
  requiredBy           TrainingRequirement[]  @relation("requirements")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model TrainingRequirement {
  training           ConfiguracionEntrenamiento @relation("requiredFor", fields: [trainingId], references: [id], onDelete: Cascade)
  trainingId         String
  requiredTraining   ConfiguracionEntrenamiento @relation("requirements", fields: [requiredTrainingId], references: [id], onDelete: Cascade)
  requiredTrainingId String
  requiredLevel      Int

  @@id([trainingId, requiredTrainingId])
}

model ConfiguracionTropa {
  id                String                   @id
  nombre            String
  urlImagen         String
  descripcion       String
  costoArmas        Int
  costoMunicion     Int
  costoDolares      Int
  duracion          Int
  puntos            Float
  ataque            Int
  defensa           Int
  capacidad         Int
  velocidad         Int
  salario           Int
  tipo              TipoTropa                @default(ATAQUE)
  requisitos        String[] // IDs de otras tropas
  bonusAtaque       String[] // IDs de entrenamientos
  bonusDefensa      String[] // IDs de entrenamientos
  TropaUsuario      TropaUsuario[]
  ColaReclutamiento ColaReclutamiento[]
  bonusContrincante TropaBonusContrincante[] @relation("atacante")
  esContrincanteDe  TropaBonusContrincante[] @relation("defensora")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
}

model TropaBonusContrincante {
  tropaAtacante    ConfiguracionTropa @relation("atacante", fields: [tropaAtacanteId], references: [id], onDelete: Cascade)
  tropaAtacanteId  String
  tropaDefensora   ConfiguracionTropa @relation("defensora", fields: [tropaDefensoraId], references: [id], onDelete: Cascade)
  tropaDefensoraId String
  factorPrioridad  Float // e.g., 1.5 para 50% más de prioridad/daño

  @@id([tropaAtacanteId, tropaDefensoraId])
}

// --- SOCIAL ---
model Family {
  id          String             @id @default(cuid())
  name        String             @unique
  tag         String             @unique
  description String?
  avatarUrl   String?
  members     FamilyMember[]
  invitations FamilyInvitation[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model FamilyMember {
  family   Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String     @unique
  role     FamilyRole @default(MEMBER)
  joinedAt DateTime   @default(now())
}

model FamilyInvitation {
  id        String   @id @default(cuid())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  status    String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt DateTime @default(now())
  expiresAt DateTime @default(dbgenerated("NOW() + INTERVAL '7 days'"))

  @@unique([familyId, userId])
}

model Message {
  id          String          @id @default(cuid())
  sender      User?           @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)
  senderId    String?
  recipient   User            @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String
  subject     String
  content     String
  isRead      Boolean         @default(false)
  category    MessageCategory
  createdAt   DateTime        @default(now())

  @@index([recipientId, createdAt])
}

enum TipoTropa {
  ATAQUE
  DEFENSA
  ESPIONAJE
  TRANSPORTE
  OCUPAR
}

enum FamilyRole {
  LEADER
  CO_LEADER
  MEMBER
}

enum MessageCategory {
  JUGADOR
  FAMILIA
  BATALLA
  ESPIONAJE
  COMERCIO
  SISTEMA
  CONSTRUCCION
}
