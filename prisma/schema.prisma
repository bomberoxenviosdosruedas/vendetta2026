// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  username       String          @unique
  password       String
  title          String?
  avatarUrl      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  progreso       ProgresoUsuario?
  propiedades    Propiedad[]
  entrenamientos EntrenamientoUsuario[]
  tropas         TropaUsuario[]
  puntuacion     PuntuacionUsuario?
}

model ProgresoUsuario {
  id                  String   @id @default(cuid())
  userId              String   @unique
  dolares             Float    @default(0)
  armas               Float    @default(0)
  municion            Float    @default(0)
  alcohol             Float    @default(0)
  ultimaActualizacion DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PuntuacionUsuario {
  id                   String @id @default(cuid())
  userId               String @unique
  puntosHabitaciones  Float  @default(0)
  puntosTropas         Float  @default(0)
  puntosEntrenamientos Float  @default(0)
  puntosTotales        Float  @default(0)
  ultimaActualizacion  DateTime @updatedAt
  user                 User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Propiedad {
  id                String              @id @default(cuid())
  userId            String
  nombre            String
  ciudad            Int
  barrio            Int
  edificio          Int
  habitaciones      HabitacionUsuario[]
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  colaConstruccion  ColaConstruccion[]
  colaReclutamiento ColaReclutamiento?

  @@unique([ciudad, barrio, edificio])
}

model HabitacionUsuario {
  id                          String                @id @default(cuid())
  propiedadId                 String
  configuracionHabitacionId  String
  nivel                       Int                   @default(0)
  propiedad                   Propiedad             @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion               ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id], onDelete: Cascade)

  @@unique([propiedadId, configuracionHabitacionId])
}

model EntrenamientoUsuario {
  id                           String                     @id @default(cuid())
  userId                       String
  configuracionEntrenamientoId String
  nivel                        Int                        @default(0)
  user                         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuracion                ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id], onDelete: Cascade)

  @@unique([userId, configuracionEntrenamientoId])
}

model TropaUsuario {
  id                     String           @id @default(cuid())
  userId                 String
  configuracionTropaId   String
  cantidad               Int
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuracion          ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id], onDelete: Cascade)

  @@unique([userId, configuracionTropaId])
}

model ColaConstruccion {
  id                String    @id @default(cuid())
  propiedadId       String
  habitacionId      String
  nivelDestino      Int
  fechaInicio       DateTime?
  fechaFinalizacion DateTime?
  createdAt         DateTime  @default(now())
  propiedad         Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
}

model ColaReclutamiento {
  id                String             @id @default(cuid())
  propiedadId       String             @unique
  tropaId           String
  cantidad          Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime
  propiedad         Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  tropaConfig       ConfiguracionTropa @relation(fields: [tropaId], references: [id], onDelete: Cascade)
}


// --- CONFIGURACIONES ESTATICAS DEL JUEGO ---

model ConfiguracionHabitacion {
  id           String                       @id
  nombre       String
  descripcion  String
  urlImagen    String
  costoArmas   Int
  costoMunicion Int
  costoDolares  Int
  duracion     Int // en segundos
  produccion   Int // produccion base
  puntos       Float
  habitaciones HabitacionUsuario[]
  escalado     ConfiguracionEscaladoHabitacion?
}

model ConfiguracionEscaladoHabitacion {
  id                    String                @id @default(cuid())
  habitacionId          String                @unique
  produccionRecurso    String? // 'armas', 'municion', 'alcohol', 'dolares'
  formulaAumentoProd   String?
  factorCostoPorNivel  Float
  formulaTiempo        String?
  habitacion            ConfiguracionHabitacion @relation(fields: [habitacionId], references: [id])
}

model ConfiguracionEntrenamiento {
  id             String                 @id
  nombre         String
  urlImagen      String
  costoArmas     Int
  costoMunicion  Int
  costoDolares   Int
  duracion       Int // en segundos
  puntos         Float
  entrenamientos EntrenamientoUsuario[]
}

model ConfiguracionTropa {
  id            String               @id
  nombre        String
  urlImagen     String
  descripcion   String
  costoArmas    Int
  costoMunicion Int
  costoDolares  Int
  duracion      Int // en segundos por unidad
  puntos        Float
  ataque        Int
  defensa       Int
  capacidad     Int
  velocidad     Int
  salario       Int
  requisitos    String[]
  bonusAtaque   String[]
  bonusDefensa  String[]
  tropas        TropaUsuario[]
  cola          ColaReclutamiento[]
}
