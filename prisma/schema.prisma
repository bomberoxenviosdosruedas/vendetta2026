
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id               String             @id @default(cuid())
  name             String
  username         String             @unique
  password         String
  title            String?
  avatarUrl        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  propiedades      Propiedad[]
  entrenamientos   EntrenamientoUsuario[]
  misiones         ColaMisiones[]
  colaEntrenamientos ColaEntrenamiento[]
  puntuacion       PuntuacionUsuario?
  familyMember     FamilyMember?
  sentMessages     Message[]          @relation("SenderMessages")
  receivedMessages Message[]          @relation("RecipientMessages")
  invitations      FamilyInvitation[]
}

model SuperUser {
  id       String @id @default(cuid())
  username String @unique
  password String
}

model Propiedad {
  id                  String               @id @default(cuid())
  userId              String
  nombre              String
  ciudad              Int
  barrio              Int
  edificio            Int
  armas               Float                @default(10000)
  municion            Float                @default(10000)
  alcohol             Float                @default(10000)
  dolares             Float                @default(10000)
  ultimaActualizacion DateTime             @default(now()) @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitaciones        HabitacionUsuario[]
  TropaUsuario        TropaUsuario[]
  colaConstruccion    ColaConstruccion[]
  colaReclutamiento   ColaReclutamiento?
  misiones            ColaMisiones[]
  colaEntrenamientos  ColaEntrenamiento[]

  @@unique([ciudad, barrio, edificio])
  @@index([userId])
}

model HabitacionUsuario {
  id                          String                @id @default(cuid())
  propiedadId                 String
  configuracionHabitacionId   String
  nivel                       Int
  propiedad                   Propiedad             @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion               ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id])

  @@unique([propiedadId, configuracionHabitacionId])
  @@index([propiedadId])
  @@index([configuracionHabitacionId])
}

model TropaUsuario {
  id                   String           @id @default(cuid())
  propiedadId          String
  configuracionTropaId String
  cantidad             Int
  propiedad            Propiedad        @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  configuracion        ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id])

  @@unique([propiedadId, configuracionTropaId])
  @@index([propiedadId])
  @@index([configuracionTropaId])
}

model EntrenamientoUsuario {
  id                           String                     @id @default(cuid())
  userId                       String
  configuracionEntrenamientoId String
  nivel                        Int
  user                         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuracion                ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id])

  @@unique([userId, configuracionEntrenamientoId])
  @@index([userId])
  @@index([configuracionEntrenamientoId])
}

model PuntuacionUsuario {
  id                   String   @id @default(cuid())
  userId               String   @unique
  puntosHabitaciones   Float
  puntosTropas         Float
  puntosEntrenamientos Float
  puntosTotales        Float
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt            DateTime @updatedAt
}

// --- Colas de Eventos ---

model ColaConstruccion {
  id                String     @id @default(cuid())
  propiedadId       String
  habitacionId      String
  nivelDestino      Int
  duracion          Int
  fechaInicio       DateTime?
  fechaFinalizacion DateTime?
  createdAt         DateTime   @default(now())
  propiedad         Propiedad  @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  @@index([propiedadId])
}

model ColaReclutamiento {
  id                String             @id @default(cuid())
  propiedadId       String             @unique
  tropaId           String
  cantidad          Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime
  propiedad         Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  tropaConfig       ConfiguracionTropa @relation(fields: [tropaId], references: [id])

  @@index([propiedadId])
}

model ColaMisiones {
  id                String    @id @default(cuid())
  userId            String
  propiedadOrigenId String?
  tipoMision        String
  tropas            String    @db.Text
  origenCiudad      Int
  origenBarrio      Int
  origenEdificio    Int
  destinoCiudad     Int
  destinoBarrio     Int
  destinoEdificio   Int
  fechaInicio       DateTime
  fechaLlegada      DateTime
  fechaRegreso      DateTime?
  velocidadFlota    Int
  duracionViaje     Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  propiedadOrigen   Propiedad? @relation(fields: [propiedadOrigenId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model ColaEntrenamiento {
  id              String                     @id @default(cuid())
  userId          String
  propiedadId     String
  entrenamientoId String
  nivelDestino    Int
  fechaInicio     DateTime
  fechaFinalizacion DateTime
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  propiedad       Propiedad                  @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  entrenamiento   ConfiguracionEntrenamiento @relation(fields: [entrenamientoId], references: [id])
  @@index([userId])
  @@index([propiedadId])
}


// --- Configuraciones Estáticas ---

model ConfiguracionHabitacion {
  id                 String              @id
  nombre             String
  descripcion        String              @db.Text
  urlImagen          String
  costoArmas         Int
  costoMunicion      Int
  costoDolares       Int
  duracion           Int
  produccionBase     Int
  produccionRecurso  String?
  puntos             Float
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  HabitacionUsuario  HabitacionUsuario[]
  requirements       RoomRequirement[]   @relation("RoomRequirements")
  requiredFor        RoomRequirement[]   @relation("RequiredForRoom")
}

model RoomRequirement {
    roomId           String
    room             ConfiguracionHabitacion @relation("RoomRequirements", fields: [roomId], references: [id], onDelete: Cascade)
    requiredRoomId   String
    requiredRoom     ConfiguracionHabitacion @relation("RequiredForRoom", fields: [requiredRoomId], references: [id], onDelete: Cascade)
    requiredLevel    Int

    @@id([roomId, requiredRoomId])
}

model ConfiguracionEntrenamiento {
  id                  String                @id
  nombre              String
  urlImagen           String
  costoArmas          Int
  costoMunicion       Int
  costoDolares        Int
  duracion            Int
  puntos              Float
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  EntrenamientoUsuario EntrenamientoUsuario[]
  ColaEntrenamiento    ColaEntrenamiento[]
  requirements        TrainingRequirement[] @relation("TrainingRequirements")
  requiredFor         TrainingRequirement[] @relation("RequiredForTraining")
}

model TrainingRequirement {
    trainingId         String
    training           ConfiguracionEntrenamiento @relation("TrainingRequirements", fields: [trainingId], references: [id], onDelete: Cascade)
    requiredTrainingId String
    requiredTraining   ConfiguracionEntrenamiento @relation("RequiredForTraining", fields: [requiredTrainingId], references: [id], onDelete: Cascade)
    requiredLevel      Int

    @@id([trainingId, requiredTrainingId])
}

enum TipoTropa {
  ATAQUE
  DEFENSA
  TRANSPORTE
  ESPIONAJE
  OCUPAR
}

model ConfiguracionTropa {
  id                String             @id
  nombre            String
  urlImagen         String
  descripcion       String             @db.Text
  costoArmas        Int
  costoMunicion     Int
  costoDolares      Int
  duracion          Int
  puntos            Float
  ataque            Int
  defensa           Int
  capacidad         Int
  velocidad         Int
  salario           Int
  tipo              TipoTropa          @default(ATAQUE)
  requisitos        String[]
  bonusAtaque       String[]
  bonusDefensa      String[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  TropaUsuario      TropaUsuario[]
  colaReclutamiento ColaReclutamiento[]
  bonusContrincante TropaBonusContrincante[] @relation("Atacante")
  esContrincanteDe  TropaBonusContrincante[] @relation("Defensor")
}

model TropaBonusContrincante {
    tropaAtacanteId   String
    tropaDefensoraId  String
    factorPrioridad   Float
    tropaAtacante     ConfiguracionTropa @relation("Atacante", fields: [tropaAtacanteId], references: [id], onDelete: Cascade)
    tropaDefensora    ConfiguracionTropa @relation("Defensor", fields: [tropaDefensoraId], references: [id], onDelete: Cascade)
    
    @@id([tropaAtacanteId, tropaDefensoraId])
}

model PoderAtaque {
  id           String @id @default(cuid())
  propiedades  Int
  honor        Int
  modificador  Int

  @@unique([propiedades, honor])
}


// --- Familias ---

enum FamilyRole {
  LEADER
  CO_LEADER
  MEMBER
}

model Family {
  id           String             @id @default(cuid())
  name         String             @unique
  tag          String             @unique
  description  String?            @db.Text
  avatarUrl    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  members      FamilyMember[]
  invitations  FamilyInvitation[]
}

model FamilyMember {
  id        String     @id @default(cuid())
  userId    String     @unique
  familyId  String
  role      FamilyRole @default(MEMBER)
  joinedAt  DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model FamilyInvitation {
  id        String           @id @default(cuid())
  familyId  String
  userId    String
  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  expiresAt DateTime
  family    Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
}

// --- Mensajes ---
enum MessageCategory {
    JUGADOR
    BATALLA
    CONSTRUCCION
    SISTEMA
}


model Message {
  id          String          @id @default(cuid())
  senderId    String?
  recipientId String
  category    MessageCategory @default(JUGADOR)
  subject     String
  content     String          @db.Text
  isRead      Boolean         @default(false)
  createdAt   DateTime        @default(now())

  sender    User? @relation("SenderMessages", fields: [senderId], references: [id], onDelete: SetNull)
  recipient User  @relation("RecipientMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
}
