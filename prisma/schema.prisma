
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id             String                 @id @default(cuid())
  name           String
  username       String                 @unique
  password       String
  title          String
  avatarUrl      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  propiedades    Propiedad[]
  entrenamientos EntrenamientoUsuario[]
  puntuacion     PuntuacionUsuario?
  misiones       ColaMisiones[]
}

model Propiedad {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id])
  nombre              String
  ciudad              Int
  barrio              Int
  edificio            Int
  armas               Float                @default(0)
  municion            Float                @default(0)
  alcohol             Float                @default(0)
  dolares             Float                @default(0)
  ultimaActualizacion DateTime             @default(now())
  habitaciones        HabitacionUsuario[]
  tropas              TropaUsuario[]
  colaConstruccion    ColaConstruccion[]
  colaReclutamiento   ColaReclutamiento?
  misiones            ColaMisiones[]       @relation("MisionesPropiedad")

  @@unique([ciudad, barrio, edificio])
}

model HabitacionUsuario {
  id                          String                  @id @default(cuid())
  propiedadId                 String
  propiedad                   Propiedad               @relation(fields: [propiedadId], references: [id])
  configuracionHabitacionId   String
  configuracion               ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id])
  nivel                       Int

  @@unique([propiedadId, configuracionHabitacionId])
}

model EntrenamientoUsuario {
  id                             String                       @id @default(cuid())
  userId                         String
  user                           User                         @relation(fields: [userId], references: [id])
  configuracionEntrenamientoId   String
  configuracion                  ConfiguracionEntrenamiento   @relation(fields: [configuracionEntrenamientoId], references: [id])
  nivel                          Int

  @@unique([userId, configuracionEntrenamientoId])
}

model TropaUsuario {
  id                      String             @id @default(cuid())
  propiedadId             String
  propiedad               Propiedad          @relation(fields: [propiedadId], references: [id])
  configuracionTropaId    String
  configuracion           ConfiguracionTropa @relation(fields: [configuracionTropaId], references: [id])
  cantidad                Int

  @@unique([propiedadId, configuracionTropaId])
}

model PuntuacionUsuario {
  id                   String @id @default(cuid())
  userId               String @unique
  user                 User   @relation(fields: [userId], references: [id])
  puntosHabitaciones  Float
  puntosTropas         Float
  puntosEntrenamientos Float
  puntosTotales        Float
}

model ColaConstruccion {
  id               String    @id @default(cuid())
  propiedadId      String
  propiedad        Propiedad @relation(fields: [propiedadId], references: [id])
  habitacionId     String
  nivelDestino     Int
  duracion         Int // en segundos
  fechaInicio      DateTime?
  fechaFinalizacion DateTime?
  createdAt        DateTime  @default(now())
}

model ColaReclutamiento {
  id                String             @id @default(cuid())
  propiedadId       String             @unique
  propiedad         Propiedad          @relation(fields: [propiedadId], references: [id])
  tropaId           String
  tropaConfig       ConfiguracionTropa @relation(fields: [tropaId], references: [id])
  cantidad          Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime
}

model ColaMisiones {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  tipoMision        String
  tropas            Json
  propiedad         Propiedad @relation("MisionesPropiedad", fields: [origenCiudad, origenBarrio, origenEdificio], references: [ciudad, barrio, edificio])
  origenCiudad      Int
  origenBarrio      Int
  origenEdificio    Int
  destinoCiudad     Int
  destinoBarrio     Int
  destinoEdificio   Int
  fechaLlegada      DateTime
  fechaRegreso      DateTime?
  duracionViaje     Int       @default(0)
  velocidadFlota    Float     @default(0)
}

// --- CONFIGURACIONES DEL JUEGO ---

model ConfiguracionHabitacion {
  id                 String                        @id
  nombre             String
  descripcion        String
  urlImagen          String
  costoArmas         Int
  costoMunicion      Int
  costoDolares       Int
  duracion           Int
  produccionBase     Float                         @default(0)
  produccionRecurso  String?
  puntos             Float
  habitaciones       HabitacionUsuario[]
  escalado           ConfiguracionEscaladoHabitacion?
}

model ConfiguracionEscaladoHabitacion {
  id                        String                  @id @default(cuid())
  habitacionId              String                  @unique
  habitacion                ConfiguracionHabitacion @relation(fields: [habitacionId], references: [id])
  factorCostoPorNivel       Float
  produccionRecurso         String?
  formulaAumentoProduccion  String?
  formulaTiempo             String?
}

model ConfiguracionEntrenamiento {
  id             String                   @id
  nombre         String
  urlImagen      String
  costoArmas     Int
  costoMunicion  Int
  costoDolares   Int
  duracion       Int
  puntos         Float
  entrenamientos EntrenamientoUsuario[]
}

model ConfiguracionTropa {
  id              String               @id
  nombre          String
  urlImagen       String
  descripcion     String
  costoArmas      Int
  costoMunicion   Int
  costoDolares    Int
  duracion        Int
  puntos          Float
  ataque          Int
  defensa         Int
  capacidad       Int
  velocidad       Int
  salario         Int
  tipo            TipoTropa            @default(ATAQUE)
  requisitos      String[]
  bonusAtaque     String[]
  bonusDefensa    String[]
  tropas          TropaUsuario[]
  colas           ColaReclutamiento[]
}

enum TipoTropa {
  ATAQUE
  DEFENSA
  OCUPAR
}
