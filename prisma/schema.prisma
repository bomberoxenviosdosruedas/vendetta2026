// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTG"
"RES_URL_NON_POOLING") // uses a direct connection
  shadowDatabaseUrl = env("POSTGRES_URL_NON_POOLING") // used for migrations
}

model User {
  id               String                 @id @default(cuid())
  name             String
  username         String                 @unique
  password         String
  title            String                 @default("Nuevo Jefe")
  avatarUrl        String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  propiedades      Propiedad[]
  entrenamientos   EntrenamientoUsuario[]
  puntuacion       PuntuacionUsuario?
  misiones         ColaMisiones[]
}

model PuntuacionUsuario {
  id                   String @id @default(cuid())
  user                 User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String @unique
  puntosHabitaciones   Float
  puntosTropas         Float
  puntosEntrenamientos Float
  puntosTotales        Float
}

model Propiedad {
  id                   String                 @id @default(cuid())
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String
  nombre               String
  ciudad               Int
  barrio               Int
  edificio             Int
  armas                Float                  @default(0)
  municion             Float                  @default(0)
  alcohol              Float                  @default(0)
  dolares              Float                  @default(0)
  ultimaActualizacion  DateTime               @default(now())
  habitaciones         HabitacionUsuario[]
  colaConstruccion     ColaConstruccion[]
  colaReclutamiento    ColaReclutamiento?
  tropas               TropaUsuario[]

  @@unique([ciudad, barrio, edificio])
}

model HabitacionUsuario {
  id                          String                  @id @default(cuid())
  propiedad                   Propiedad               @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId                 String
  configuracion               ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id], onDelete: Cascade)
  configuracionHabitacionId   String
  nivel                       Int

  @@unique([propiedadId, configuracionHabitacionId])
}

model EntrenamientoUsuario {
  id                              String                       @id @default(cuid())
  user                            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                          String
  configuracion                   ConfiguracionEntrenamiento @relation(fields: [configuracionEntrenamientoId], references: [id], onDelete: Cascade)
  configuracionEntrenamientoId    String
  nivel                           Int

  @@unique([userId, configuracionEntrenamientoId])
}

model TropaUsuario {
  id                          String                @id @default(cuid())
  propiedad                   Propiedad             @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId                 String
  configuracion               ConfiguracionTropa    @relation(fields: [configuracionTropaId], references: [id], onDelete: Cascade)
  configuracionTropaId        String
  cantidad                    Int

  @@unique([propiedadId, configuracionTropaId])
}

// --- TABLAS DE CONFIGURACIÓN ---

model ConfiguracionHabitacion {
  id                   String                            @id @unique
  nombre               String
  descripcion          String
  urlImagen            String?
  costoArmas           Int
  costoMunicion        Int
  costoDolares         Int
  duracion             Int
  produccionBase       Int
  produccionRecurso    String?
  puntos               Float
  habitaciones         HabitacionUsuario[]
  escalado             ConfiguracionEscaladoHabitacion?
  colaConstruccion     ColaConstruccion[]
}

model ConfiguracionEscaladoHabitacion {
  id                         String                  @id @default(cuid())
  configuracionHabitacion    ConfiguracionHabitacion @relation(fields: [configuracionHabitacionId], references: [id], onDelete: Cascade)
  configuracionHabitacionId  String                  @unique
  factorCostoPorNivel        Float                   @default(1.2)
  produccionRecurso          String?
}

model ConfiguracionEntrenamiento {
  id             String                   @id @unique
  nombre         String
  urlImagen      String?
  costoArmas     Int
  costoMunicion  Int
  costoDolares   Int
  duracion       Int
  puntos         Float
  entrenamientos EntrenamientoUsuario[]
}

model ConfiguracionTropa {
  id             String          @id @unique
  nombre         String
  urlImagen      String?
  descripcion    String
  costoArmas     Int
  costoMunicion  Int
  costoDolares   Int
  duracion       Int
  puntos         Float
  ataque         Int
  defensa        Int
  capacidad      Int
  velocidad      Int
  salario        Int
  tipo           TipoTropa       @default(ATAQUE)
  requisitos     String[]
  bonusAtaque    String[]
  bonusDefensa   String[]
  tropasUsuario  TropaUsuario[]
  colaReclutamiento ColaReclutamiento[]
}

enum TipoTropa {
  ATAQUE
  DEFENSA
  ESPIONAJE
  OCUPAR
  TRANSPORTE
}

// --- COLAS DE EVENTOS ---
model ColaConstruccion {
  id               String                   @id @default(cuid())
  propiedad        Propiedad                @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId      String
  habitacion       ConfiguracionHabitacion  @relation(fields: [habitacionId], references: [id], onDelete: Cascade)
  habitacionId     String
  nivelDestino     Int
  duracion         Int
  fechaInicio      DateTime?
  fechaFinalizacion DateTime?
  createdAt        DateTime                 @default(now())
}

model ColaReclutamiento {
  id                String             @id @default(cuid())
  propiedad         Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  propiedadId       String             @unique
  tropaConfig       ConfiguracionTropa @relation(fields: [tropaId], references: [id], onDelete: Cascade)
  tropaId           String
  cantidad          Int
  fechaInicio       DateTime
  fechaFinalizacion DateTime
}

model ColaMisiones {
  id                String       @id @default(cuid())
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  tipoMision        String
  tropas            String // JSON string de las tropas
  origenCiudad      Int
  origenBarrio      Int
  origenEdificio    Int
  destinoCiudad     Int
  destinoBarrio     Int
  destinoEdificio   Int
  fechaInicio       DateTime
  fechaLlegada      DateTime
  fechaRegreso      DateTime?
  duracionViaje     Int
  velocidadFlota    Int
}

enum TipoMision {
  ATAQUE
  DEFENDER
  ESPIONAJE
  OCUPAR
  TRANSPORTE
  REGRESO
}
