# ----------------------------------------------------
# Vendetta - Git Ignore Configuration
# ----------------------------------------------------

# Dependencias
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Compilación y Salida de Next.js
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# Variables de Entorno y Secretos (nunca subir claves ni credenciales)
.env
.env*.local
.env.development
.env.production
.env.test
!.env.example

# Logs y Depuración
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*

# Cobertura de Pruebas
/coverage
/.nyc_output

# Plataformas en la Nube y Caches de Despliegue
.vercel
/.idx/
.genkit/*

# Archivos del Sistema Operativo e IDEs
.DS_Store
Thumbs.db
*.pem
*.key
*.cert
.idea/
*.sublime-project
*.sublime-workspace

# Artefactos y Bases de Datos Locales
*.sqlite
*.sqlite3
*.db
/src/generated/prisma
/vendetta/
/vendetta

# Multimedia y Assets Binarios Pesados (también en .aiexclude)
public/img/
public/nuevas/
public/icons/
public/*.gif
public/*.jpg
public/*.jpeg
public/*.png
public/*.webp
public/*.svg
public/*.ico
*.mp4
*.mp3
*.wav
*.pdf

# Volcados y Semillas de Datos Masivos (también en .aiexclude)
prisma/datosactuales/
prisma/export/
prisma/importar/
prisma/*.json
*.sql
*.sqlite
*.sqlite3
*.dump
*.csv
*.tsv
*.xlsx

# Lockfiles (opcional - descomenta si no quieres commitearlos)
# pnpm-lock.yaml
# package-lock.json

# TypeScript build info
*.tsbuildinfo